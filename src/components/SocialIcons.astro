---
import PwIcon from './PwIcon.astro';

const isMs = (Astro.locals.starlightRoute?.locale ?? 'en') === 'ms';
const connectLabel = isMs ? 'Hubungi' : 'Connect';
const mainLabel = isMs ? 'Laman utama' : 'Main site';
const mapLabel = isMs ? 'Peta' : 'Map';
const websiteLabel = isMs ? 'Laman web' : 'Website';

const links = [
  { icon: 'fa-linktree', label: 'Linktree', href: 'https://linktr.ee/putrajaya.rblx' },
  {
    icon: 'bi-controller',
    label: 'Roblox',
    href: 'https://www.roblox.com/communities/33831801/Wilayah-Persekutuan-Putrajaya#!/about',
  },
  { icon: 'fa-discord', label: 'Discord', href: 'https://discord.gg/Ng8rVaE7bX' },
  { icon: 'fa-x-twitter', label: 'X', href: 'https://x.com/PutrajayaOfRBLX' },
  { icon: 'fa-youtube', label: 'YouTube', href: 'https://www.youtube.com/@PutrajayaOfRoblox' },
  { icon: 'fa-tiktok', label: 'TikTok', href: 'https://www.tiktok.com/@putrajaya.rblx' },
  {
    icon: 'bi-globe',
    label: websiteLabel,
    href: 'https://putrajayarblx.github.io/putrajaya-of-roblox/',
  },
  {
    icon: 'bi-github',
    label: 'GitHub',
    href: 'https://github.com/Putrajayarblx/Putrajayarblx-Wiki',
  },
];
---

<a class="pw-top-link" href={`${isMs ? '/ms' : ''}/map/`}>
  <PwIcon name="bi-map" />
  <span>{mapLabel}</span>
</a>

<a class="pw-top-link" href="https://putrajayarblx.github.io/putrajaya-of-roblox/">
  <PwIcon name="bi-house-door" />
  <span>{mainLabel}</span>
</a>

<div class="pw-cmenu" data-pw-connect>
  <button
    class="pw-cmenu__trigger"
    type="button"
    aria-expanded="false"
    aria-controls="pw-connect-panel"
  >
    <PwIcon name="bi-link-45deg" />
    <span>{connectLabel}</span>
    <PwIcon name="bi-chevron-down" class="pw-cmenu__chev" />
  </button>

  <div class="pw-cmenu__panel" id="pw-connect-panel" hidden>
    {
      links.map((link) => (
        <a href={link.href} title={link.label} target="_blank" rel="noopener noreferrer">
          <PwIcon name={link.icon} />
          <span>{link.label}</span>
        </a>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll('[data-pw-connect]').forEach((box) => {
    const trigger = box.querySelector<HTMLButtonElement>('.pw-cmenu__trigger');
    const panel = box.querySelector<HTMLElement>('.pw-cmenu__panel');
    if (!trigger || !panel) return;

    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
    };

    trigger.addEventListener('click', () => setOpen(panel.hidden));
    panel.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !box.contains(event.target)) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) {
        setOpen(false);
        trigger.focus();
      }
    });
  });
</script>
