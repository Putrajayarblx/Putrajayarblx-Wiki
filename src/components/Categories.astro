---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { getCollection } from 'astro:content';
import PwIcon from './PwIcon.astro';

const locale = Astro.locals.starlightRoute?.locale ?? 'en';
const isMs = locale === 'ms';
const all = await getCollection('docs');
const isMsEntry = (id: string) => id === 'ms' || id.startsWith('ms/');

const entries = all.filter((entry) => (isMs ? isMsEntry(entry.id) : !isMsEntry(entry.id)));
const docs = entries.filter(
  (entry) =>
    entry.id !== 'index' &&
    entry.id !== 'ms' &&
    !entry.id.endsWith('404') &&
    Boolean(entry.data.category)
);

const groups = new Map<string, typeof docs>();
for (const doc of docs) {
  const category = doc.data.category as string;
  if (!groups.has(category)) groups.set(category, []);
  groups.get(category).push(doc);
}

// Fall back to the English landing page when a locale has no local hub.
// The route still gets the /ms/ prefix so the language stays put.
const englishLandings = all.filter(
  (entry) =>
    !isMsEntry(entry.id) &&
    entry.id !== 'index' &&
    entry.id !== 'ms' &&
    !entry.id.endsWith('404') &&
    Boolean(entry.data.category) &&
    Boolean(entry.data.landing)
);

const preferred = ['Start here', 'City', 'Companies'];
const sorted = [...groups.entries()].sort((a, b) => {
  const ia = preferred.indexOf(a[0]);
  const ib = preferred.indexOf(b[0]);
  return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a[0].localeCompare(b[0]);
});

const categories = sorted.map(([name, items]) => {
  const localLanding = items.find((doc) => doc.data.landing);
  const fallbackLanding =
    !localLanding && isMs
      ? englishLandings.find((entry) => entry.data.category === name)
      : undefined;
  const source = localLanding ?? fallbackLanding ?? items[0];

  let image = source.data.image;
  if (image && /\.(png|jpe?g)$/i.test(image)) {
    const webp = image.replace(/\.(png|jpe?g)$/i, '.webp');
    if (existsSync(join(process.cwd(), 'public', webp))) image = webp;
  }

  const href = localLanding
    ? `/${localLanding.id}/`
    : fallbackLanding
      ? `/ms/${fallbackLanding.id}/`
      : `/${items[0].id}/`;

  return {
    name,
    slug: name.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
    title: name,
    description: source.data.description ?? '',
    image,
    href,
  };
});
---

<div class="pw-grid pw-cats">
  {
    categories.map((cat) => (
      <a class="pw-cat" href={cat.href}>
        {cat.image ? (
          <img class="pw-cat__image" src={cat.image} alt="" loading="lazy" decoding="async" />
        ) : (
          <div class={`pw-cat__image pw-cat__image--${cat.slug}`} aria-hidden="true" />
        )}
        <div class="pw-cat__body">
          <h3 class="pw-cat__title">{cat.title}</h3>
          <p>{cat.description}</p>
          <span class="pw-card__cta">
            Open category <PwIcon name="bi-arrow-right" />
          </span>
        </div>
      </a>
    ))
  }
</div>
