---
import { getCollection } from 'astro:content';
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { execSync } from 'node:child_process';

const locale = Astro.locals.starlightRoute?.locale ?? 'en';
const isMs = locale === 'ms';

const all = await getCollection('docs');
const isMsEntry = (id: string) => id === 'ms' || id.startsWith('ms/');
const is404 = (id: string) => id.endsWith('404');

const key = (id: string) => id.replace(/^ms\//, '').replace(/^index$/, 'home');

// One entry per page, preferring the current locale with English fallback.
const byKey = new Map<string, (typeof all)[number]>();
for (const entry of all.filter((e) => !isMsEntry(e.id) && !is404(e.id))) byKey.set(key(entry.id), entry);
if (isMs) {
  for (const entry of all.filter((e) => isMsEntry(e.id) && !is404(e.id))) byKey.set(key(entry.id), entry);
}

const available = [...byKey.values()];
const docsRoot = join(process.cwd(), 'src/content/docs');
const localeRoot = isMs ? join(docsRoot, 'ms') : docsRoot;
const isLanding = (entry: (typeof available)[number]) => existsSync(join(docsRoot, entry.id));
const articles = available.filter(
  (entry) => !isLanding(entry) && entry.id !== 'index' && entry.id !== 'ms'
).length;
const sections = existsSync(localeRoot)
  ? readdirSync(localeRoot, { withFileTypes: true }).filter(
      (d) => d.isDirectory() && d.name.toLowerCase() !== 'ms'
    ).length
  : 1;
const languages = 2;

let updated = '2026-11-02';
try {
  const out = execSync('git log -1 --format=%cs -- src/content/docs', {
    encoding: 'utf8',
    stdio: ['ignore', 'pipe', 'ignore'],
  }).trim();
  if (/^\d{4}-\d{2}-\d{2}$/.test(out)) updated = out;
} catch {
  // No git history available (e.g. a plain copy of the folder).
}

const updatedLabel = new Intl.DateTimeFormat(isMs ? 'ms-MY' : 'en-MY', {
  month: 'short',
  year: 'numeric',
}).format(new Date(`${updated}T00:00:00Z`));

const t = isMs
  ? { articles: 'Artikel', sections: 'Kategori', languages: 'Bahasa', updated: 'Dikemas kini' }
  : { articles: 'Articles', sections: 'Categories', languages: 'Languages', updated: 'Updated' };
---

<div class="pw-stats">
  <div class="pw-stat"><strong>{articles}</strong><span>{t.articles}</span></div>
  <div class="pw-stat"><strong>{sections}</strong><span>{t.sections}</span></div>
  <div class="pw-stat"><strong>{languages}</strong><span>{t.languages}</span></div>
  <div class="pw-stat"><strong>{updatedLabel}</strong><span>{t.updated}</span></div>
</div>

