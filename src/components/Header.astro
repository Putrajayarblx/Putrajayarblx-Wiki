---
import Default from '@astrojs/starlight/components/Header.astro';
import PwIcon from './PwIcon.astro';
import Appearance from './Appearance.astro';
import ImageZoom from './ImageZoom.astro';
import HeroImages from './HeroImages.astro';
import { getCollection } from 'astro:content';

const locale = Astro.locals.starlightRoute.locale ?? 'en';
const isMs = locale === 'ms';
const base = isMs ? '/ms' : '';

const t = isMs
  ? {
      menu: 'Menu',
      search: 'Cari',
      dark: 'Mod gelap',
      light: 'Mod cerah',
      start: 'Mula di sini',
      roles: 'Peranan dan jabatan',
      connect: 'Hubungi',
      website: 'Laman web',
    }
  : {
      menu: 'Menu',
      search: 'Search',
      dark: 'Dark mode',
      light: 'Light mode',
      start: 'Getting started',
      roles: 'Roles and departments',
      connect: 'Connect',
      website: 'Website',
    };

const allDocs = await getCollection('docs');
const isMsEntry = (id: string) => id === 'ms' || id.startsWith('ms/');
const wikiDocs = allDocs.filter(
  (entry) =>
    (isMs ? isMsEntry(entry.id) : !isMsEntry(entry.id)) &&
    entry.id !== 'index' &&
    entry.id !== 'ms' &&
    !entry.id.endsWith('404') &&
    Boolean(entry.data.category)
);
const navGroups = new Map<string, typeof wikiDocs>();
for (const doc of wikiDocs) {
  const category = doc.data.category as string;
  if (!navGroups.has(category)) navGroups.set(category, []);
  navGroups.get(category)!.push(doc);
}
const preferredCategories = ['Start here', 'City', 'Companies'];
const nav = [...navGroups.entries()]
  .sort((a, b) => {
    const ia = preferredCategories.indexOf(a[0]);
    const ib = preferredCategories.indexOf(b[0]);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a[0].localeCompare(b[0]);
  })
  .map(([label, items]) => ({
    label,
    items: items.sort(
      (a, b) =>
        Number(Boolean(b.data.landing)) - Number(Boolean(a.data.landing)) ||
        a.data.title.localeCompare(b.data.title)
    ),
  }));

const connect = [
  { icon: 'fa-linktree', label: 'Linktree', href: 'https://linktr.ee/putrajaya.rblx' },
  {
    icon: 'bi-controller',
    label: 'Roblox',
    href: 'https://www.roblox.com/communities/33831801/Wilayah-Persekutuan-Putrajaya#!/about',
  },
  { icon: 'fa-discord', label: 'Discord', href: 'https://discord.gg/Ng8rVaE7bX' },
  { icon: 'fa-x-twitter', label: 'X', href: 'https://x.com/PutrajayaOfRBLX' },
  { icon: 'fa-youtube', label: 'YouTube', href: 'https://www.youtube.com/@PutrajayaOfRoblox' },
  { icon: 'fa-tiktok', label: 'TikTok', href: 'https://www.tiktok.com/@putrajaya.rblx' },
  {
    icon: 'bi-globe',
    label: t.website,
    href: 'https://putrajayarblx.github.io/putrajaya-of-roblox/',
  },
  { icon: 'bi-github', label: 'GitHub', href: 'https://github.com/Putrajayarblx/Putrajayarblx-Wiki' },
];
---

<Default />

<div class="pw-progress" aria-hidden="true"><span data-pw-progress-bar></span></div>

<div class="pw-mnav" data-pw-menu>
  <button
    class="pw-mnav__button"
    type="button"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="pw-menu-panel"
  >
    <PwIcon name="bi-list" class="pw-mnav__icon-open" />
    <PwIcon name="bi-x-lg" class="pw-mnav__icon-close" />
  </button>

  <div class="pw-mnav__scrim" data-pw-menu-close hidden></div>

  <nav
    class="pw-mnav__sheet"
    id="pw-menu-panel"
    aria-label={t.menu}
    data-light-label={t.light}
    data-dark-label={t.dark}
    hidden
  >
    <p class="pw-mnav__title">{t.menu}</p>

    <button class="pw-mnav__row" type="button" data-pw-search>
      <PwIcon name="bi-search" />
      <span>{t.search}</span>
      <kbd>Ctrl K</kbd>
    </button>

    <button class="pw-mnav__row" type="button" data-pw-theme aria-pressed="false">
      <PwIcon name="bi-moon-stars" class="pw-mnav__theme-moon" />
      <PwIcon name="bi-sun" class="pw-mnav__theme-sun" />
      <span data-pw-theme-label>{t.dark}</span>
      <span class="pw-mnav__switch" aria-hidden="true"><span></span></span>
    </button>

    <div class="pw-mnav__divider" role="presentation"></div>

    <p class="pw-mnav__title">{t.connect}</p>

    {
      connect.map((link) => (
        <a href={link.href} target="_blank" rel="noopener noreferrer">
          <PwIcon name={link.icon} />
          {link.label}
        </a>
      ))
    }
  </nav>
</div>

<Appearance />

<ImageZoom />

<HeroImages />

<script>
  const root = document.documentElement;

  // ---- scroll progress + header background state ----
  const bar = document.querySelector('[data-pw-progress-bar]');
  const onScroll = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = max > 0 ? Math.min(1, window.scrollY / max) : 0;
    if (bar) bar.style.transform = `scaleX(${ratio})`;
    root.classList.toggle('pw-scrolled', window.scrollY > 6 && window.innerWidth >= 1152);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);

  // ---- any search trigger (hero, menu) opens Starlight's modal ----
  // Open Starlight's search via its keyboard shortcut. Clicking the header
  // button races with Pagefind's async init and gets swallowed on first click.
  const openSearch = () => {
    const dialog = document.querySelector<HTMLDialogElement>('site-search dialog');
    if (dialog?.open) return;

    document.dispatchEvent(
      new KeyboardEvent('keydown', { key: 'k', ctrlKey: true, bubbles: true })
    );

    if (!dialog?.open) {
      try {
        dialog?.showModal();
      } catch {
        /* already open */
      }
    }
  };
  document.querySelectorAll('[data-pw-search]').forEach((el) => {
    el.addEventListener('click', (event) => {
      // Keep the click from bubbling to Starlight's "click outside" handler,
      // which would close the dialog immediately after we open it.
      event.stopPropagation();
      const sheet = el.closest('.pw-mnav__sheet');
      if (sheet instanceof HTMLElement) sheet.hidden = true;
      window.setTimeout(openSearch, 0);
    });
  });

  // ---- mobile menu ----
  document.querySelectorAll('[data-pw-menu]').forEach((menu) => {
    const button = menu.querySelector('.pw-mnav__button');
    const sheet = menu.querySelector<HTMLElement>('.pw-mnav__sheet');
    const scrim = menu.querySelector('.pw-mnav__scrim');
    if (!button || !sheet || !scrim) return;

    const lightLabel = sheet.dataset.lightLabel ?? 'Light mode';
    const darkLabel = sheet.dataset.darkLabel ?? 'Dark mode';

    const setOpen = (open: boolean) => {
      sheet.hidden = !open;
      scrim.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    };

    button.addEventListener('click', () => setOpen(sheet.hidden));
    scrim.addEventListener('click', () => setOpen(false));
    sheet.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !sheet.hidden) setOpen(false);
    });

    const themeButton = sheet.querySelector('[data-pw-theme]');
    const themeLabel = sheet.querySelector('[data-pw-theme-label]');
    const syncTheme = () => {
      const dark = root.dataset.theme === 'dark';
      if (themeLabel) themeLabel.textContent = dark ? lightLabel : darkLabel;
      themeButton?.setAttribute('aria-pressed', String(dark));
    };
    themeButton?.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      localStorage.setItem('starlight-theme', next);
      syncTheme();
    });
    syncTheme();
  });
</script>
