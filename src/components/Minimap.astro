---
import 'leaflet/dist/leaflet.css';
import data from '../data/minimap.json';

interface Props {
  locale?: 'en' | 'ms';
}

const locale: 'en' | 'ms' = Astro.props.locale === 'ms' ? 'ms' : 'en';
const { bounds, pois } = data;

const strings = {
  en: {
    searchLabel: 'Search places on the map',
    searchPlaceholder: 'Search places…',
    filterLabel: 'Filter places by category',
    mapLabel: 'Interactive map of Putrajaya',
    mapAlt: 'Map of Putrajaya showing roads, water and districts',
    hintMouse: 'Drag to pan · Scroll to zoom',
    hintTouch: 'Drag to pan · Pinch to zoom',
    placesLabel: 'Places on the map',
    places: 'Places',
    reset: 'Reset',
    empty: 'No places match your search.',
    copyLink: 'Copy link',
    copied: 'Copied!',
    countJoin: 'of',
    countUnit: 'places',
    zoomIn: 'Zoom in',
    zoomOut: 'Zoom out',
  },
  ms: {
    searchLabel: 'Cari tempat pada peta',
    searchPlaceholder: 'Cari tempat…',
    filterLabel: 'Tapis tempat mengikut kategori',
    mapLabel: 'Peta interaktif Putrajaya',
    mapAlt: 'Peta Putrajaya yang menunjukkan jalan, air dan daerah',
    hintMouse: 'Seret untuk geser · Tatal untuk zum',
    hintTouch: 'Seret untuk geser · Cubit untuk zum',
    placesLabel: 'Tempat pada peta',
    places: 'Tempat',
    reset: 'Set semula',
    empty: 'Tiada tempat sepadan dengan carian anda.',
    copyLink: 'Salin pautan',
    copied: 'Disalin!',
    countJoin: 'daripada',
    countUnit: 'tempat',
    zoomIn: 'Zum masuk',
    zoomOut: 'Zum keluar',
  },
}[locale];

const categoryLabels: Record<'en' | 'ms', Record<string, string>> = {
  en: {
    all: 'All',
    government: 'Government',
    emergency: 'Emergency',
    services: 'Services',
    transport: 'Transport',
    landmarks: 'Landmarks',
    parks: 'Parks',
    other: 'Other',
  },
  ms: {
    all: 'Semua',
    government: 'Kerajaan',
    emergency: 'Kecemasan',
    services: 'Perkhidmatan',
    transport: 'Pengangkutan',
    landmarks: 'Mercu tanda',
    parks: 'Taman',
    other: 'Lain-lain',
  },
};

const typeLabels: Record<'en' | 'ms', Record<string, string>> = {
  en: {
    GovtMarker: 'Government',
    SecurityMarker: 'Police',
    FireDeptMarker: 'Fire & rescue',
    HospitalMarker: 'Health',
    ShopMarker: 'Shop',
    DealershipMarker: 'Dealership',
    MailOfficeMarker: 'Post office',
    BusStopMarker: 'Bus stop',
    BoatStopMarker: 'Boat stop',
    ParkingMarker: 'Parking',
    BridgeMarker: 'Bridge',
    MosqueMarker: 'Mosque',
    TouristMarker: 'Landmark',
    ParkMarker: 'Park',
    VenueMarker: 'Venue',
    Marker: 'Point of interest',
  },
  ms: {
    GovtMarker: 'Kerajaan',
    SecurityMarker: 'Polis',
    FireDeptMarker: 'Bomba & penyelamat',
    HospitalMarker: 'Kesihatan',
    ShopMarker: 'Kedai',
    DealershipMarker: 'Pengedar kereta',
    MailOfficeMarker: 'Pejabat pos',
    BusStopMarker: 'Hentian bas',
    BoatStopMarker: 'Hentian bot',
    ParkingMarker: 'Parkir',
    BridgeMarker: 'Jambatan',
    MosqueMarker: 'Masjid',
    TouristMarker: 'Mercu tanda',
    ParkMarker: 'Taman',
    VenueMarker: 'Tempat acara',
    Marker: 'Tempat menarik',
  },
};

const categories = Object.entries(categoryLabels[locale]).map(([id, label]) => ({ id, label }));

const localizedPois = pois.map((poi) => {
  const typeLabel = typeLabels[locale][poi.t] ?? poi.catLabel;
  if (locale === 'en' || poi.n?.trim()) {
    return { ...poi, catLabel: typeLabel };
  }
  const number = poi.label.match(/(\d+)$/)?.[0];
  return {
    ...poi,
    label: number ? `${typeLabel} ${number}` : typeLabel,
    catLabel: typeLabel,
  };
});

const counts = Object.fromEntries(
  categories.map((category) => [
    category.id,
    category.id === 'all'
      ? localizedPois.length
      : localizedPois.filter((poi) => poi.cat === category.id).length,
  ])
);

const payload = JSON.stringify({
  bounds,
  pois: localizedPois,
  locale,
  labels: {
    copyLink: strings.copyLink,
    copied: strings.copied,
    countJoin: strings.countJoin,
    countUnit: strings.countUnit,
    mapAlt: strings.mapAlt,
    zoomIn: strings.zoomIn,
    zoomOut: strings.zoomOut,
  },
});
---

<div class="pw-map" data-pw-map>
  <div class="pw-map__head">
    <label class="pw-map__search">
      <span class="sr-only">{strings.searchLabel}</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input type="search" placeholder={strings.searchPlaceholder} autocomplete="off" data-map-search />
    </label>

    <div class="pw-map__filters" role="group" aria-label={strings.filterLabel}>
      {
        categories.map((category, index) => (
          <button
            type="button"
            class:list={{ 'is-active': index === 0 }}
            data-map-filter={category.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {category.label}
            <span>{counts[category.id]}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="pw-map__layout">
    <div class="pw-map__canvas-wrap">
      <div class="pw-map__canvas" data-map-canvas aria-label={strings.mapLabel}></div>
      <p class="pw-map__hint">
        <span class="pw-map__hint-mouse">{strings.hintMouse}</span>
        <span class="pw-map__hint-touch">{strings.hintTouch}</span>
      </p>
      <span class="pw-map__compass" aria-hidden="true">N</span>
    </div>

    <aside class="pw-map__side" aria-label={strings.placesLabel}>
      <div class="pw-map__side-head">
        <h2>{strings.places}</h2>
        <button type="button" class="pw-map__reset" data-map-reset>{strings.reset}</button>
      </div>
      <p class="pw-map__count" data-map-count>
        {localizedPois.length} {strings.countJoin} {localizedPois.length} {strings.countUnit}
      </p>
      <ul class="pw-map__list" data-map-list></ul>
      <p class="pw-map__empty" data-map-empty hidden>{strings.empty}</p>
    </aside>
  </div>
</div>

<script type="application/json" id="pw-map-data" set:html={payload} />

<script>
  import L from 'leaflet';

  const root = document.querySelector<HTMLElement>('[data-pw-map]');
  const canvas = root?.querySelector<HTMLElement>('[data-map-canvas]');
  const list = root?.querySelector<HTMLElement>('[data-map-list]');
  const count = root?.querySelector<HTMLElement>('[data-map-count]');
  const empty = root?.querySelector<HTMLElement>('[data-map-empty]');
  const search = root?.querySelector<HTMLInputElement>('[data-map-search]');
  const reset = root?.querySelector<HTMLButtonElement>('[data-map-reset]');
  const filterButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-map-filter]') ?? [])];
  const source = document.getElementById('pw-map-data');

  type Poi = {
    id: string;
    label: string;
    cat: string;
    catLabel: string;
    glyph: string;
    x: number;
    z: number;
  };

  type Data = {
    bounds: { minX: number; maxX: number; minZ: number; maxZ: number };
    pois: Poi[];
    locale: 'en' | 'ms';
    labels: {
      copyLink: string;
      copied: string;
      countJoin: string;
      countUnit: string;
      mapAlt: string;
      zoomIn: string;
      zoomOut: string;
    };
  };

  if (root && canvas && list && source) {
    const data = JSON.parse(source.textContent || '{}') as Data;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bounds = L.latLngBounds(
      [-data.bounds.maxZ, data.bounds.minX],
      [-data.bounds.minZ, data.bounds.maxX]
    );

    const map = L.map(canvas, {
      crs: L.CRS.Simple,
      minZoom: -6,
      maxZoom: 1,
      zoomSnap: 0.1,
      zoomDelta: 0.5,
      attributionControl: false,
      zoomControl: false,
      maxBoundsViscosity: 1,
      maxBounds: bounds.pad(0.25),
      zoomAnimation: !reduceMotion,
      fadeAnimation: !reduceMotion,
      markerZoomAnimation: !reduceMotion,
    });

    L.imageOverlay('/minimap.svg', bounds, {
      alt: data.labels.mapAlt,
    }).addTo(map);

    const fitMap = () => {
      map.fitBounds(bounds, { padding: [14, 14] });
      map.setMinZoom(map.getZoom());
    };
    fitMap();
    L.control.zoom({
      position: 'bottomright',
      zoomInTitle: data.labels.zoomIn,
      zoomOutTitle: data.labels.zoomOut,
    }).addTo(map);

    const markerLayer = L.layerGroup().addTo(map);
    const markerById = new Map<string, L.Marker>();
    const poiById = new Map(data.pois.map((poi) => [poi.id, poi]));

    const esc = (value: string) =>
      value.replace(/[&<>"']/g, (character) => {
        const entities: Record<string, string> = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        };
        return entities[character] ?? character;
      });

    const popupHtml = (poi: Poi) => `
      <div class="pw-map-popup">
        <p class="pw-map-popup__cat">${esc(poi.catLabel)}</p>
        <h3>${esc(poi.label)}</h3>
        <p class="pw-map-popup__coords">X ${poi.x.toFixed(1)} · Z ${poi.z.toFixed(1)}</p>
        <button type="button" class="pw-map-popup__copy" data-copy-poi="${poi.id}">${esc(data.labels.copyLink)}</button>
      </div>
    `;

    for (const poi of data.pois) {
      const marker = L.marker([-poi.z, poi.x], {
        icon: L.divIcon({
          className: `pw-map-pin pw-map-pin--${poi.cat}`,
          html: `<span class="pw-map-pin__glyph" aria-hidden="true">${poi.glyph}</span>`,
          iconSize: [32, 32],
          iconAnchor: [16, 16],
          popupAnchor: [0, -16],
        }),
        title: poi.label,
        alt: poi.label,
        keyboard: true,
        riseOnHover: true,
      });

      marker.bindTooltip(poi.label, {
        direction: 'top',
        offset: [0, -14],
        className: 'pw-map-tooltip',
        opacity: 1,
      });
      marker.bindPopup(popupHtml(poi), {
        closeButton: false,
        offset: [0, -18],
        className: 'pw-map-popup-wrap',
        maxWidth: 280,
      });
      marker.on('click', () => {
        selectPoi(poi, false);
      });
      markerById.set(poi.id, marker);
    }

    let activeId: string | null = null;
    let query = '';
    let category = 'all';

    const setActive = (id: string | null) => {
      activeId = id;
      for (const item of list.querySelectorAll<HTMLElement>('[data-poi-id]')) {
        const active = item.dataset.poiId === id;
        item.classList.toggle('is-active', active);
        if (active) item.setAttribute('aria-current', 'true');
        else item.removeAttribute('aria-current');
      }
    };

    const setUrl = (poi: Poi | null) => {
      const url = new URL(window.location.href);
      if (poi) url.searchParams.set('poi', poi.id);
      else url.searchParams.delete('poi');
      history.replaceState(null, '', url);
    };

    const focusPoi = (poi: Poi, animate = true) => {
      const marker = markerById.get(poi.id);
      if (!marker) return;
      const target = [-poi.z, poi.x] as L.LatLngExpression;
      const zoom = Math.max(map.getZoom(), -1);
      if (animate && !reduceMotion) map.flyTo(target, zoom, { duration: 0.8 });
      else map.setView(target, zoom);
      marker.openPopup();
      setActive(poi.id);
    };

    const selectPoi = (poi: Poi, focusMap = true) => {
      if (focusMap) focusPoi(poi);
      setActive(poi.id);
      setUrl(poi);
    };

    const render = () => {
      const needle = query.trim().toLowerCase();
      const visible = data.pois.filter((poi) => {
        const matchesCategory = category === 'all' || poi.cat === category;
        const matchesQuery =
          !needle ||
          poi.label.toLowerCase().includes(needle) ||
          poi.catLabel.toLowerCase().includes(needle);
        return matchesCategory && matchesQuery;
      });

      markerLayer.clearLayers();
      for (const poi of visible) {
        const marker = markerById.get(poi.id);
        if (marker) markerLayer.addLayer(marker);
      }

      list.innerHTML = visible
        .map(
          (poi) => `
            <li>
              <button type="button" class="pw-map-item${
                activeId === poi.id ? ' is-active' : ''
              }" data-poi-id="${poi.id}"${
                activeId === poi.id ? ' aria-current="true"' : ''
              }>
                <span class="pw-map-pin pw-map-pin--${poi.cat}" aria-hidden="true">
                  <span class="pw-map-pin__glyph">${poi.glyph}</span>
                </span>
                <span class="pw-map__item__body">
                  <strong>${esc(poi.label)}</strong>
                  <small>${esc(poi.catLabel)}</small>
                </span>
              </button>
            </li>
          `
        )
        .join('');

      if (count)
        count.textContent = `${visible.length} ${data.labels.countJoin} ${data.pois.length} ${data.labels.countUnit}`;
      if (empty) empty.hidden = visible.length > 0;

      if (activeId && !visible.some((poi) => poi.id === activeId)) {
        map.closePopup();
        setActive(null);
      }
    };

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        category = button.dataset.mapFilter ?? 'all';
        for (const other of filterButtons) {
          const active = other === button;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-pressed', String(active));
        }
        render();
      });
    }

    search?.addEventListener('input', () => {
      query = search.value;
      render();
    });

    reset?.addEventListener('click', () => {
      query = '';
      category = 'all';
      if (search) search.value = '';
      for (const button of filterButtons) {
        const active = button.dataset.mapFilter === 'all';
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      }
      map.closePopup();
      setActive(null);
      setUrl(null);
      render();
      fitMap();
    });

    list.addEventListener('click', (event) => {
      const target = (event.target as Element).closest<HTMLElement>('[data-poi-id]');
      if (!target) return;
      const poi = poiById.get(target.dataset.poiId ?? '');
      if (poi) selectPoi(poi);
    });

    document.addEventListener('click', (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy-poi]');
      if (!button) return;
      const id = button.dataset.copyPoi;
      if (!id) return;
      const url = `${window.location.origin}${window.location.pathname}?poi=${encodeURIComponent(id)}`;
      const done = () => {
        const original = button.textContent;
        button.textContent = data.labels.copied;
        window.setTimeout(() => {
          button.textContent = original;
        }, 1600);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(done);
      } else {
        done();
      }
    });

    const initialId = new URLSearchParams(window.location.search).get('poi');
    render();
    if (initialId) {
      const poi = poiById.get(initialId);
      if (poi) {
        focusPoi(poi, false);
        setUrl(poi);
      }
    }

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(() => {
        const atOverview = map.getZoom() <= map.getMinZoom() + 0.01;
        map.invalidateSize();
        if (atOverview) fitMap();
      });
      observer.observe(canvas);
    }
  }
</script>

<style is:global>
  .pw-map {
    margin: 1.25rem 0 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 18px;
    background: var(--pw-card-bg);
    box-shadow: var(--pw-shadow-sm);
    overflow: hidden;
  }

  .pw-map__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .pw-map__search {
    display: flex;
    align-items: center;
    flex: 1 1 14rem;
    gap: 0.5rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 10px;
    background: var(--sl-color-bg);
    color: var(--pw-muted);
  }

  .pw-map__search svg {
    flex: none;
    width: 1rem;
    height: 1rem;
  }

  .pw-map__search input {
    width: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--sl-color-text);
    font: inherit;
    font-size: 0.9rem;
  }

  .pw-map__search input::placeholder {
    color: var(--pw-muted);
  }

  .pw-map__filters {
    display: flex;
    flex: 1 1 100%;
    flex-wrap: nowrap;
    gap: 0.35rem;
    min-width: 0;
    overflow-x: auto;
    padding-bottom: 0.15rem;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .pw-map__filters::-webkit-scrollbar {
    display: none;
  }

  .pw-map__filters button {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 999px;
    background: transparent;
    color: var(--pw-muted);
    font: inherit;
    font-size: 0.72rem;
    font-weight: 650;
    cursor: pointer;
  }

  .pw-map__filters button span {
    color: inherit;
    opacity: 0.65;
    font-size: 0.65rem;
  }

  .pw-map__filters button:hover,
  .pw-map__filters button.is-active {
    border-color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    color: var(--sl-color-accent-high);
  }

  .pw-map__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 17rem;
    grid-template-rows: minmax(0, 1fr);
    height: 34rem;
    min-height: 0;
  }

  .pw-map__canvas-wrap {
    position: relative;
    min-width: 0;
    min-height: 0;
  }

  .pw-map__canvas {
    width: 100%;
    height: 100%;
    min-height: 0;
    background: #a4ce8d;
  }

  .pw-map__hint,
  .pw-map__compass {
    position: absolute;
    z-index: 500;
    pointer-events: none;
  }

  .pw-map__hint {
    bottom: 0.8rem;
    left: 0.8rem;
    margin: 0;
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: rgb(16 32 58 / 72%);
    color: #fff;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .pw-map__hint-touch {
    display: none;
  }

  @media (pointer: coarse) {
    .pw-map__hint-mouse {
      display: none;
    }

    .pw-map__hint-touch {
      display: inline;
    }
  }

  .pw-map__compass {
    top: 0.8rem;
    left: 0.8rem;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid rgb(16 32 58 / 18%);
    border-radius: 50%;
    background: rgb(255 255 255 / 82%);
    color: #10203a;
    font-size: 0.7rem;
    font-weight: 800;
    box-shadow: 0 4px 12px rgb(16 32 58 / 12%);
  }

  .pw-map__side {
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    border-left: 1px solid var(--sl-color-hairline);
    background: color-mix(in srgb, var(--sl-color-bg) 55%, transparent);
  }

  .pw-map__side-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.8rem 0.9rem 0.25rem;
  }

  .pw-map__side-head h2 {
    margin: 0;
    border: 0;
    padding: 0;
    font-size: 0.95rem;
  }

  .pw-map__reset {
    border: 0;
    background: transparent;
    color: var(--sl-color-accent);
    font: inherit;
    font-size: 0.7rem;
    font-weight: 650;
    cursor: pointer;
  }

  .pw-map__reset:hover {
    text-decoration: underline;
  }

  .pw-map__count {
    margin: 0;
    padding: 0 0.9rem 0.65rem;
    color: var(--pw-muted);
    font-size: 0.7rem;
  }

  .pw-map__list {
    flex: 1;
    min-height: 0;
    max-height: none;
    margin: 0;
    padding: 0 0.45rem 0.5rem;
    overflow-y: auto;
    list-style: none;
    scrollbar-width: thin;
  }

  .pw-map__item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: 100%;
    padding: 0.45rem 0.45rem;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--sl-color-text);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .pw-map__item:hover,
  .pw-map__item.is-active {
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
  }

  .pw-map__item.is-active {
    box-shadow: inset 2px 0 0 var(--sl-color-accent);
  }

  .pw-map__item__body {
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
    min-width: 0;
  }

  .pw-map__item__body strong {
    overflow: hidden;
    color: var(--sl-color-text);
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.3;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pw-map__item__body small {
    color: var(--pw-muted);
    font-size: 0.65rem;
  }

  .pw-map__empty {
    margin: 0;
    padding: 1rem 0.9rem;
    color: var(--pw-muted);
    font-size: 0.78rem;
  }

  .pw-map-pin {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.65rem;
    height: 1.65rem;
    border: 2px solid #fff;
    border-radius: 50%;
    background: #5f6b7a;
    box-shadow: 0 4px 10px rgb(16 32 58 / 30%);
    font-size: 0.72rem;
    line-height: 1;
  }

  .pw-map-pin--government {
    background: #355a9e;
