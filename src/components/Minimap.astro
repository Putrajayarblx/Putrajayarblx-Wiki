---
import 'leaflet/dist/leaflet.css';
import data from '../data/minimap.json';

interface Props {
  locale?: 'en' | 'ms';
}

const locale: 'en' | 'ms' = Astro.props.locale === 'ms' ? 'ms' : 'en';
const { bounds, pois } = data;

const strings = {
  en: {
    searchLabel: 'Search places on the map',
    searchPlaceholder: 'Search places…',
    filterLabel: 'Filter places by category',
    mapLabel: 'Interactive map of Putrajaya',
    mapAlt: 'Map of Putrajaya showing roads, water and districts',
    hintMouse: 'Drag to pan · Scroll to zoom',
    hintTouch: 'Drag to pan · Pinch to zoom',
    empty: 'No places match your search.',
    copyLink: 'Copy link',
    copied: 'Copied!',
    zoomIn: 'Zoom in',
    zoomOut: 'Zoom out',
    measure: {
      title: 'Measure',
      distance: 'Distance',
      area: 'Area',
      units: 'Units',
      finish: 'Finish',
      undo: 'Undo',
      clear: 'Clear',
      close: 'Close',
      expand: 'Expand',
      collapse: 'Collapse',
      start: 'Click the map to start a measurement.',
      addPoints: 'Click the map to add points.',
      hint: 'Click map to add points · double-click to finish.',
      finishHint: 'Double-click or choose Finish to close it.',
      needPoints: 'Add at least 3 points.',
      total: 'Total',
      areaLabel: 'Area',
      perimeter: 'Perimeter',
      completed: 'Completed',
      measurements: 'measurements',
      measurement: 'measurement',
      points: 'points',
      point: 'point',
      empty: 'No measurement yet.',
      fromPoi: 'Measure from here',
      studNote: '1 stud = 0.28 m',
    },
  },
  ms: {
    searchLabel: 'Cari tempat pada peta',
    searchPlaceholder: 'Cari tempat…',
    filterLabel: 'Tapis tempat mengikut kategori',
    mapLabel: 'Peta interaktif Putrajaya',
    mapAlt: 'Peta Putrajaya yang menunjukkan jalan, air dan daerah',
    hintMouse: 'Seret untuk geser · Tatal untuk zum',
    hintTouch: 'Seret untuk geser · Cubit untuk zum',
    empty: 'Tiada tempat sepadan dengan carian anda.',
    copyLink: 'Salin pautan',
    copied: 'Disalin!',
    zoomIn: 'Zum masuk',
    zoomOut: 'Zum keluar',
    measure: {
      title: 'Ukur',
      distance: 'Jarak',
      area: 'Luas',
      units: 'Unit',
      finish: 'Selesai',
      undo: 'Batal',
      clear: 'Kosongkan',
      close: 'Tutup',
      expand: 'Kembangkan',
      collapse: 'Kecilkan',
      start: 'Klik peta untuk mula mengukur.',
      addPoints: 'Klik peta untuk tambah titik.',
      hint: 'Klik peta untuk tambah titik · klik dua kali untuk selesai.',
      finishHint: 'Klik dua kali atau pilih Selesai untuk menutup.',
      needPoints: 'Tambah sekurang-kurangnya 3 titik.',
      total: 'Jumlah',
      areaLabel: 'Luas',
      perimeter: 'Perimeter',
      completed: 'Selesai',
      measurements: 'ukuran',
      measurement: 'ukuran',
      points: 'titik',
      point: 'titik',
      empty: 'Belum ada ukuran.',
      fromPoi: 'Ukur dari sini',
      studNote: '1 stud = 0.28 m',
    },
  },
}[locale];

const STUD_METERS = 0.28;

const distanceUnits = {
  en: [
    { id: 'studs', label: 'Studs', short: 'studs', factor: 1, decimals: 1 },
    { id: 'meters', label: 'Meters', short: 'm', factor: STUD_METERS, decimals: 2 },
    {
      id: 'feet',
      label: 'Feet',
      short: 'ft',
      factor: STUD_METERS * 3.280839895013123,
      decimals: 1,
    },
    { id: 'kilometers', label: 'Kilometres', short: 'km', factor: STUD_METERS / 1000, decimals: 3 },
    { id: 'miles', label: 'Miles', short: 'mi', factor: STUD_METERS / 1609.344, decimals: 3 },
  ],
  ms: [
    { id: 'studs', label: 'Stud', short: 'stud', factor: 1, decimals: 1 },
    { id: 'meters', label: 'Meter', short: 'm', factor: STUD_METERS, decimals: 2 },
    {
      id: 'feet',
      label: 'Kaki',
      short: 'ft',
      factor: STUD_METERS * 3.280839895013123,
      decimals: 1,
    },
    { id: 'kilometers', label: 'Kilometer', short: 'km', factor: STUD_METERS / 1000, decimals: 3 },
    { id: 'miles', label: 'Batu', short: 'mi', factor: STUD_METERS / 1609.344, decimals: 3 },
  ],
};

const areaUnits = {
  en: [
    { id: 'sqStuds', label: 'Square studs', short: 'stud²', factor: 1, decimals: 0 },
    { id: 'sqMeters', label: 'Square metres', short: 'm²', factor: STUD_METERS ** 2, decimals: 1 },
    {
      id: 'sqFeet',
      label: 'Square feet',
      short: 'ft²',
      factor: STUD_METERS ** 2 * 10.763910416709722,
      decimals: 0,
    },
    {
      id: 'hectares',
      label: 'Hectares',
      short: 'ha',
      factor: (STUD_METERS ** 2) / 10000,
      decimals: 2,
    },
    {
      id: 'acres',
      label: 'Acres',
      short: 'ac',
      factor: (STUD_METERS ** 2) / 4046.8564224,
      decimals: 2,
    },
    {
      id: 'sqKilometers',
      label: 'Square kilometres',
      short: 'km²',
      factor: (STUD_METERS ** 2) / 1e6,
      decimals: 3,
    },
  ],
  ms: [
    { id: 'sqStuds', label: 'Stud persegi', short: 'stud²', factor: 1, decimals: 0 },
    { id: 'sqMeters', label: 'Meter persegi', short: 'm²', factor: STUD_METERS ** 2, decimals: 1 },
    {
      id: 'sqFeet',
      label: 'Kaki persegi',
      short: 'ft²',
      factor: STUD_METERS ** 2 * 10.763910416709722,
      decimals: 0,
    },
    {
      id: 'hectares',
      label: 'Hektar',
      short: 'ha',
      factor: (STUD_METERS ** 2) / 10000,
      decimals: 2,
    },
    {
      id: 'acres',
      label: 'Ekar',
      short: 'ac',
      factor: (STUD_METERS ** 2) / 4046.8564224,
      decimals: 2,
    },
    {
      id: 'sqKilometers',
      label: 'Kilometer persegi',
      short: 'km²',
      factor: (STUD_METERS ** 2) / 1e6,
      decimals: 3,
    },
  ],
};

const categoryLabels: Record<'en' | 'ms', Record<string, string>> = {
  en: {
    all: 'All',
    government: 'Government',
    emergency: 'Emergency',
    services: 'Services',
    transport: 'Transport',
    landmarks: 'Landmarks',
    parks: 'Parks',
    other: 'Other',
  },
  ms: {
    all: 'Semua',
    government: 'Kerajaan',
    emergency: 'Kecemasan',
    services: 'Perkhidmatan',
    transport: 'Pengangkutan',
    landmarks: 'Mercu tanda',
    parks: 'Taman',
    other: 'Lain-lain',
  },
};

const typeLabels: Record<'en' | 'ms', Record<string, string>> = {
  en: {
    GovtMarker: 'Government',
    SecurityMarker: 'Police',
    FireDeptMarker: 'Fire & rescue',
    HospitalMarker: 'Health',
    ShopMarker: 'Shop',
    DealershipMarker: 'Dealership',
    MailOfficeMarker: 'Post office',
    BusStopMarker: 'Bus stop',
    BoatStopMarker: 'Boat stop',
    ParkingMarker: 'Parking',
    BridgeMarker: 'Bridge',
    MosqueMarker: 'Mosque',
    TouristMarker: 'Landmark',
    ParkMarker: 'Park',
    VenueMarker: 'Venue',
    Marker: 'Point of interest',
  },
  ms: {
    GovtMarker: 'Kerajaan',
    SecurityMarker: 'Polis',
    FireDeptMarker: 'Bomba & penyelamat',
    HospitalMarker: 'Kesihatan',
    ShopMarker: 'Kedai',
    DealershipMarker: 'Pengedar kereta',
    MailOfficeMarker: 'Pejabat pos',
    BusStopMarker: 'Hentian bas',
    BoatStopMarker: 'Hentian bot',
    ParkingMarker: 'Parkir',
    BridgeMarker: 'Jambatan',
    MosqueMarker: 'Masjid',
    TouristMarker: 'Mercu tanda',
    ParkMarker: 'Taman',
    VenueMarker: 'Tempat acara',
    Marker: 'Tempat menarik',
  },
};

const iconFiles: Record<string, string> = {
  BoatStopMarker: 'MapBoat.png',
  BridgeMarker: 'MapBridge.png',
  BusStopMarker: 'MapBus.png',
  DealershipMarker: 'MapDealership.png',
  FireDeptMarker: 'MapFireDept.png',
  GovtMarker: 'MapGovt.png',
  HospitalMarker: 'MapHospital.png',
  MailOfficeMarker: 'MapMail.png',
  MosqueMarker: 'MapMosque.png',
  ParkMarker: 'MapPark.png',
  ParkingMarker: 'MapParking.png',
  SecurityMarker: 'MapSecurity.png',
  ShopMarker: 'MapShop.png',
  TouristMarker: 'MapTourist.png',
  VenueMarker: 'MapVenue.png',
};

const categories = Object.entries(categoryLabels[locale]).map(([id, label]) => ({ id, label }));

const localizedPois = pois.map((poi) => {
  const typeLabel = typeLabels[locale][poi.t] ?? poi.catLabel;
  let label = poi.label;
  if (locale !== 'en' && !poi.n?.trim()) {
    const number = poi.label.match(/(\d+)$/)?.[0];
    label = number ? `${typeLabel} ${number}` : typeLabel;
  }
  return {
    ...poi,
    label,
    catLabel: typeLabel,
    iconFile: iconFiles[poi.t] ?? 'generic',
  };
});

const counts = Object.fromEntries(
  categories.map((category) => [
    category.id,
    category.id === 'all'
      ? localizedPois.length
      : localizedPois.filter((poi) => poi.cat === category.id).length,
  ])
);

const payload = JSON.stringify({
  bounds,
  pois: localizedPois,
  labels: {
    copyLink: strings.copyLink,
    copied: strings.copied,
    mapAlt: strings.mapAlt,
    zoomIn: strings.zoomIn,
    zoomOut: strings.zoomOut,
  },
  measure: {
    ...strings.measure,
    distanceUnits: distanceUnits[locale],
    areaUnits: areaUnits[locale],
  },
});
---

<div class="not-content pw-map" data-pw-map>
  <div class="pw-map__canvas" data-map-canvas aria-label={strings.mapLabel}></div>

  <div class="pw-map__overlay">
    <label class="pw-map__search">
      <span class="sr-only">{strings.searchLabel}</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input type="search" placeholder={strings.searchPlaceholder} autocomplete="off" data-map-search />
    </label>

    <div class="pw-map__filters" data-map-filters role="group" aria-label={strings.filterLabel}>
      {
        categories.map((category, index) => (
          <button
            type="button"
            class:list={{ 'is-active': index === 0 }}
            data-map-filter={category.id}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {category.label}
            <span>{counts[category.id]}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="pw-measure" data-pw-measure>
    <div class="pw-measure__panel" data-measure-panel role="group" aria-label={strings.measure.title} hidden>
      <div class="pw-measure__head">
        <strong data-measure-title>{strings.measure.distance}</strong>
        <span class="pw-measure__head-actions">
          <button
            type="button"
            class="pw-measure__collapse"
            data-measure-collapse
            aria-expanded="true"
            aria-label={strings.measure.collapse}
            title={strings.measure.collapse}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <button
            type="button"
            class="pw-measure__close"
            data-measure-close
            aria-label={strings.measure.close}
            title={strings.measure.close}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 6 12 12M18 6 6 18"></path>
            </svg>
          </button>
        </span>
      </div>

      <label class="pw-measure__units">
        <span>{strings.measure.units}</span>
        <select data-measure-units></select>
      </label>

      <div class="pw-measure__readout">
        <span class="pw-measure__readout-label" data-measure-readout-label>{strings.measure.total}</span>
        <strong data-measure-value>—</strong>
        <small data-measure-alt></small>
      </div>

      <p class="pw-measure__hint" data-measure-hint>{strings.measure.start}</p>

      <div class="pw-measure__actions">
        <button type="button" data-measure-undo disabled>{strings.measure.undo}</button>
        <button type="button" class="is-primary" data-measure-finish disabled>{strings.measure.finish}</button>
        <button type="button" data-measure-clear disabled>{strings.measure.clear}</button>
      </div>

      <p class="pw-measure__note">{strings.measure.studNote}</p>
    </div>

    <div class="pw-measure__tools" role="group" aria-label={strings.measure.title}>
      <button
        type="button"
        class="pw-measure__tool"
        data-measure-mode="distance"
        aria-pressed="false"
        aria-label={strings.measure.distance}
        title={strings.measure.distance}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 17 17 4l3 3L7 20l-3-3Z"></path>
          <path d="m7 14 2 2M10 11l2 2M13 8l2 2"></path>
        </svg>
      </button>
      <button
        type="button"
        class="pw-measure__tool"
        data-measure-mode="area"
        aria-pressed="false"
        aria-label={strings.measure.area}
        title={strings.measure.area}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7.5 12 3l8 5-2 10-10 2-4-8.5Z"></path>
          <circle cx="4" cy="7.5" r="1.3" fill="currentColor" stroke="none"></circle>
          <circle cx="12" cy="3" r="1.3" fill="currentColor" stroke="none"></circle>
          <circle cx="20" cy="8" r="1.3" fill="currentColor" stroke="none"></circle>
          <circle cx="18" cy="18" r="1.3" fill="currentColor" stroke="none"></circle>
          <circle cx="8" cy="20" r="1.3" fill="currentColor" stroke="none"></circle>
        </svg>
      </button>
    </div>
  </div>

  <p class="pw-map__empty" data-map-empty hidden>{strings.empty}</p>

  <p class="pw-map__hint">
    <span class="pw-map__hint-mouse">{strings.hintMouse}</span>
    <span class="pw-map__hint-touch">{strings.hintTouch}</span>
  </p>
</div>

<script type="application/json" id="pw-map-data" set:html={payload} />

<script>
  import L from 'leaflet';

  const root = document.querySelector<HTMLElement>('[data-pw-map]');
  const canvas = root?.querySelector<HTMLElement>('[data-map-canvas]');
  const search = root?.querySelector<HTMLInputElement>('[data-map-search]');
  const searchBox = root?.querySelector<HTMLElement>('.pw-map__search');
  const filters = root?.querySelector<HTMLElement>('[data-map-filters]');
  const empty = root?.querySelector<HTMLElement>('[data-map-empty]');
  const filterButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-map-filter]') ?? [])];
  const measurePanel = root?.querySelector<HTMLElement>('[data-measure-panel]');
  const measureTitle = root?.querySelector<HTMLElement>('[data-measure-title]');
  const measureUnitsSelect = root?.querySelector<HTMLSelectElement>('[data-measure-units]');
  const measureReadoutLabel = root?.querySelector<HTMLElement>('[data-measure-readout-label]');
  const measureValue = root?.querySelector<HTMLElement>('[data-measure-value]');
  const measureAlt = root?.querySelector<HTMLElement>('[data-measure-alt]');
  const measureHint = root?.querySelector<HTMLElement>('[data-measure-hint]');
  const measureUndo = root?.querySelector<HTMLButtonElement>('[data-measure-undo]');
  const measureFinish = root?.querySelector<HTMLButtonElement>('[data-measure-finish]');
  const measureClear = root?.querySelector<HTMLButtonElement>('[data-measure-clear]');
  const measureClose = root?.querySelector<HTMLButtonElement>('[data-measure-close]');
  const measureCollapse = root?.querySelector<HTMLButtonElement>('[data-measure-collapse]');
  const measureToolButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-measure-mode]') ?? [])];  const source = document.getElementById('pw-map-data');

  type Poi = {
    id: string;
    label: string;
    cat: string;
    catLabel: string;
    iconFile: string;
    textColor: string;
    poiColor: string;
    x: number;
    z: number;
  };

  type Unit = {
    id: string;
    label: string;
    short: string;
    factor: number;
    decimals: number;
  };

  type Data = {
    bounds: { minX: number; maxX: number; minZ: number; maxZ: number };
    pois: Poi[];
    labels: {
      copyLink: string;
      copied: string;
      mapAlt: string;
      zoomIn: string;
      zoomOut: string;
    };
    measure: {
      title: string;
      distance: string;
      area: string;
      units: string;
      finish: string;
      undo: string;
      clear: string;
      close: string;
      expand: string;
      collapse: string;
      start: string;
      addPoints: string;
      hint: string;
      finishHint: string;
      needPoints: string;
      total: string;
      areaLabel: string;
      perimeter: string;
      completed: string;
      measurements: string;
      measurement: string;
      points: string;
      point: string;
      empty: string;
      fromPoi: string;
      studNote: string;
      distanceUnits: Unit[];
      areaUnits: Unit[];
    };
  };

  type Rect = { left: number; top: number; right: number; bottom: number };
  type Side = 'right' | 'bottom' | 'left' | 'top';

  const LABEL_H = 18;
  const LABEL_GAP = 5;
  const ICON_HALF = 15;
  const PAD_X = 6;
  const PAD_Y = 3;
  const SIDES: Side[] = ['right', 'bottom', 'left', 'top'];

  if (root && canvas && source) {
    const data = JSON.parse(source.textContent || '{}') as Data;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bounds = L.latLngBounds(
      [-data.bounds.maxZ, data.bounds.minX],
      [-data.bounds.minZ, data.bounds.maxX]
    );

    const map = L.map(canvas, {
      crs: L.CRS.Simple,
      minZoom: -6,
      maxZoom: 1,
      zoomSnap: 0.1,
      zoomDelta: 0.5,
      attributionControl: false,
      zoomControl: false,
      maxBoundsViscosity: 1,
      maxBounds: bounds.pad(0.25),
      zoomAnimation: !reduceMotion,
      fadeAnimation: !reduceMotion,
      markerZoomAnimation: !reduceMotion,
    });

    L.imageOverlay('/minimap.svg', bounds, {
      alt: data.labels.mapAlt,
    }).addTo(map);

    const fitMap = () => {
      map.fitBounds(bounds, { padding: [14, 14] });
      map.setMinZoom(map.getZoom());
    };
    fitMap();
    L.control.zoom({
      position: 'bottomright',
      zoomInTitle: data.labels.zoomIn,
      zoomOutTitle: data.labels.zoomOut,
    }).addTo(map);

    const markerLayer = L.layerGroup().addTo(map);
    const markerById = new Map<string, L.Marker>();
    const poiById = new Map(data.pois.map((poi) => [poi.id, poi]));
    const labelWidths = new Map<string, number>();
    let visiblePois: Poi[] = [];
    let activeId: string | null = null;
    let query = '';
    let category = 'all';

    const esc = (value: string) =>
      value.replace(/[&<>"']/g, (character) => {
        const entities: Record<string, string> = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        };
        return entities[character] ?? character;
      });

    const categoryTints: Record<string, string> = {
      government: '#355a9e',
      emergency: '#c4454f',
      services: '#c48b3f',
      transport: '#2c8a86',
      landmarks: '#9a5d9c',
      parks: '#4f8a55',
      other: '#5f6b7a',
    };

    const heroMarkup = (poi: Poi) => {
      if (poi.iconFile === 'generic') {
        const pinColor = esc(poi.poiColor || '#78909C');
        return `<svg class="pw-poi-card__img" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a7 7 0 0 0-7 7c0 4.6 7 12 7 12s7-7.4 7-12a7 7 0 0 0-7-7Z" fill="${pinColor}" stroke="#16233a" stroke-width="1.6"/><circle cx="12" cy="9.5" r="2.6" fill="#fff"/></svg>`;
      }
      return `<img class="pw-poi-card__img" src="/MapIcons/${poi.iconFile}" alt="" width="56" height="56" />`;
    };

    const popupHtml = (poi: Poi) => {
      const xPct = (poi.x - data.bounds.minX) / (data.bounds.maxX - data.bounds.minX);
      const yPct = (poi.z - data.bounds.minZ) / (data.bounds.maxZ - data.bounds.minZ);
      const heroWidth = 288;
      const heroHeight = 96;
      const scale = 9;
      const imageHeight = scale * heroWidth * (1245 / 2400);
      const bgX = ((0.5 - scale * xPct) / (1 - scale)) * 100;
      const bgY = ((0.5 - (imageHeight / heroHeight) * yPct) / (1 - imageHeight / heroHeight)) * 100;
      return `
        <div class="pw-poi-card" style="--poi-tint:${categoryTints[poi.cat] ?? '#5f6b7a'};--hero-x:${bgX}%;--hero-y:${bgY}%">
          <div class="pw-poi-card__hero" aria-hidden="true">
            <span class="pw-poi-card__map"></span>
            ${heroMarkup(poi)}
          </div>
          <div class="pw-poi-card__body">
            <span class="pw-poi-card__kind">${esc(poi.catLabel)}</span>
            <h3>${esc(poi.label)}</h3>
            <p class="pw-poi-card__coords">X ${poi.x.toFixed(1)} · Z ${poi.z.toFixed(1)}</p>
            <div class="pw-poi-card__actions">
              <button type="button" class="pw-poi-card__btn" data-copy-poi="${poi.id}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="10" height="10" rx="2"></rect><path d="M15 9V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path></svg>
                ${esc(data.labels.copyLink)}
              </button>
              <button type="button" class="pw-poi-card__btn pw-poi-card__btn--accent" data-measure-poi="${poi.id}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17 17 4l3 3L7 20l-3-3Z"></path><path d="m7 14 2 2M10 11l2 2M13 8l2 2"></path></svg>
                ${esc(data.measure.fromPoi)}
              </button>
            </div>
          </div>
        </div>
      `;
    };

    const iconMarkup = (poi: Poi) => {
      if (poi.iconFile === 'generic') {
        const pinColor = esc(poi.poiColor || '#78909C');
        return `<svg class="pw-poi__icon pw-poi__icon--generic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a7 7 0 0 0-7 7c0 4.6 7 12 7 12s7-7.4 7-12a7 7 0 0 0-7-7Z" fill="${pinColor}" stroke="#16233a" stroke-width="2"/><circle cx="12" cy="9.5" r="2.6" fill="#fff"/></svg>`;
      }
      return `<img class="pw-poi__icon" src="/MapIcons/${poi.iconFile}" alt="" width="30" height="30" draggable="false" />`;
    };

    for (const poi of data.pois) {
      const marker = L.marker([-poi.z, poi.x], {
        icon: L.divIcon({
          className: 'pw-poi',
          html: `${iconMarkup(poi)}<span class="pw-poi__label" style="color:${esc(poi.textColor || '#FFFFFF')}">${esc(poi.label)}</span>`,
          iconSize: [30, 30],
          iconAnchor: [15, 15],
          popupAnchor: [0, -18],
        }),
        keyboard: true,
        riseOnHover: true,
      });

      marker.bindPopup(popupHtml(poi), {
        closeButton: false,
        offset: [0, -18],
        className: 'pw-map-popup-wrap',
        maxWidth: 340,
        minWidth: 300,
      });
      marker.on('click', () => selectPoi(poi));
      markerById.set(poi.id, marker);
    }

    const setActive = (id: string | null) => {
      activeId = id;
      for (const [poiId, marker] of markerById) {
        const el = marker.getElement();
        if (el) el.classList.toggle('is-active', poiId === id);
      }
    };

    const setUrl = (poi: Poi | null) => {
      const url = new URL(window.location.href);
      if (poi) url.searchParams.set('poi', poi.id);
      else url.searchParams.delete('poi');
      history.replaceState(null, '', url);
    };

    const measureLabels = () => {
      for (const [id, marker] of markerById) {
        const label = marker.getElement()?.querySelector<HTMLElement>('.pw-poi__label');
        if (label) labelWidths.set(id, Math.ceil(label.offsetWidth));
      }
    };

    const overlaps = (a: Rect, b: Rect) =>
      a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;

    const labelRect = (side: Side, cx: number, cy: number, width: number): Rect => {
      if (side === 'right') {
        return {
          left: cx + ICON_HALF + LABEL_GAP,
          top: cy - LABEL_H / 2 - PAD_Y,
          right: cx + ICON_HALF + LABEL_GAP + width + PAD_X,
          bottom: cy + LABEL_H / 2 + PAD_Y,
        };
      }
      if (side === 'left') {
        return {
          left: cx - ICON_HALF - LABEL_GAP - width - PAD_X,
          top: cy - LABEL_H / 2 - PAD_Y,
          right: cx - ICON_HALF - LABEL_GAP,
          bottom: cy + LABEL_H / 2 + PAD_Y,
        };
      }
      if (side === 'bottom') {
        return {
          left: cx - width / 2 - PAD_X,
          top: cy + ICON_HALF + LABEL_GAP,
          right: cx + width / 2 + PAD_X,
          bottom: cy + ICON_HALF + LABEL_GAP + LABEL_H + PAD_Y * 2,
        };
      }
      return {
        left: cx - width / 2 - PAD_X,
        top: cy - ICON_HALF - LABEL_GAP - LABEL_H - PAD_Y * 2,
        right: cx + width / 2 + PAD_X,
        bottom: cy - ICON_HALF - LABEL_GAP,
      };
    };

    const updateLabels = () => {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      if (!width || !height) return;

      const canvasRect = canvas.getBoundingClientRect();
      const blocked: Rect[] = [];
      for (const el of [searchBox, filters]) {
        if (!el) continue;
        const r = el.getBoundingClientRect();
        blocked.push({
          left: r.left - canvasRect.left - 2,
          top: r.top - canvasRect.top - 2,
          right: r.right - canvasRect.left + 2,
          bottom: r.bottom - canvasRect.top + 2,
        });
      }

      const icons: Rect[] = [];
      const entries: { poi: Poi; el: HTMLElement; cx: number; cy: number }[] = [];
      for (const poi of visiblePois) {
        const marker = markerById.get(poi.id);
        const el = marker?.getElement();
        if (!el) continue;
        const point = map.latLngToContainerPoint([-poi.z, poi.x]);
        icons.push({
          left: point.x - ICON_HALF,
          top: point.y - ICON_HALF,
          right: point.x + ICON_HALF,
          bottom: point.y + ICON_HALF,
        });
        entries.push({ poi, el, cx: point.x, cy: point.y });
      }

      const centerX = width / 2;
      const centerY = height / 2;
      entries.sort(
        (a, b) =>
          (a.cx - centerX) ** 2 +
          (a.cy - centerY) ** 2 -
          ((b.cx - centerX) ** 2 + (b.cy - centerY) ** 2)
      );

      const placed: Rect[] = [];
      for (const entry of entries) {
        const labelWidth = labelWidths.get(entry.poi.id) ?? 0;
        let chosen: Side | null = null;

        if (labelWidth > 0) {
          for (const side of SIDES) {
            const rect = labelRect(side, entry.cx, entry.cy, labelWidth);
            if (rect.left < 0 || rect.top < 0 || rect.right > width || rect.bottom > height) continue;
            if (blocked.some((b) => overlaps(rect, b))) continue;
            if (icons.some((i) => overlaps(rect, i))) continue;
            if (placed.some((p) => overlaps(rect, p))) continue;
            chosen = side;
            placed.push(rect);
            break;
          }
        }

        if (chosen) entry.el.dataset.labelSide = chosen;
        else delete entry.el.dataset.labelSide;
      }
    };

    let labelFrame = 0;
    const scheduleLabelUpdate = () => {
      if (labelFrame) return;
      labelFrame = requestAnimationFrame(() => {
        labelFrame = 0;
        updateLabels();
      });
    };

    const render = () => {
      const needle = query.trim().toLowerCase();
      const visible = data.pois.filter((poi) => {
        const matchesCategory = category === 'all' || poi.cat === category;
        const matchesQuery =
          !needle ||
          poi.label.toLowerCase().includes(needle) ||
          poi.catLabel.toLowerCase().includes(needle);
        return matchesCategory && matchesQuery;
      });
      visiblePois = visible;

      markerLayer.clearLayers();
      for (const poi of visible) {
        const marker = markerById.get(poi.id);
        if (!marker) continue;
        markerLayer.addLayer(marker);
        const el = marker.getElement();
        if (el) {
          el.setAttribute('aria-label', poi.label);
          el.setAttribute('role', 'button');
        }
      }

      if (empty) empty.hidden = visible.length > 0;
      if (activeId && !visible.some((poi) => poi.id === activeId)) {
        map.closePopup();
        setActive(null);
        setUrl(null);
      }

      measureLabels();
      updateLabels();
    };

    const setUrlForPoi = (poi: Poi) => setUrl(poi);

    const selectPoi = (poi: Poi) => {
      setActive(poi.id);
      setUrlForPoi(poi);
      scheduleLabelUpdate();
    };

    const focusPoi = (poi: Poi, animate = true) => {
      const marker = markerById.get(poi.id);
      if (!marker) return;
      const target = [-poi.z, poi.x] as L.LatLngExpression;
      const zoom = Math.max(map.getZoom(), -1);
      if (animate && !reduceMotion) map.flyTo(target, zoom, { duration: 0.8 });
      else map.setView(target, zoom);
      marker.openPopup();
      setActive(poi.id);
      scheduleLabelUpdate();
    };

    // ---------- Measurement tools ----------
    const measureCopy = data.measure;
    const measurePane = map.createPane('pwMeasurePane');
    measurePane.style.zIndex = '650';
    measurePane.style.pointerEvents = 'none';

    const measureLayer = L.layerGroup().addTo(map);
    const previewLayer = L.layerGroup().addTo(map);

    type MeasureMode = 'distance' | 'area';
    type MeasurePath = { kind: MeasureMode; points: L.LatLng[] };

    const measurePaths: MeasurePath[] = [];
    let measureMode: MeasureMode | null = null;
    let measureActive: MeasurePath | null = null;
    let measureCollapsed = false;
    let distanceUnit = measureCopy.distanceUnits[0];
    let areaUnit = measureCopy.areaUnits[0];
    const measureBreakpoint = window.matchMedia('(max-width: 50rem)');

    const studsUnit =
      measureCopy.distanceUnits.find((unit) => unit.id === 'studs') ?? measureCopy.distanceUnits[0];
    const metersUnit =
      measureCopy.distanceUnits.find((unit) => unit.id === 'meters') ?? measureCopy.distanceUnits[0];
    const feetUnit =
      measureCopy.distanceUnits.find((unit) => unit.id === 'feet') ?? measureCopy.distanceUnits[0];

    const numberLocale = document.documentElement.lang === 'ms' ? 'ms-MY' : 'en-MY';
    const formatNumber = (value: number, decimals: number) =>
      value.toLocaleString(numberLocale, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      });
    const formatValue = (value: number, unit: Unit) =>
      `${formatNumber(value * unit.factor, unit.decimals)} ${unit.short}`;
    const pointLabel = (count: number) =>
      `${count} ${count === 1 ? measureCopy.point : measureCopy.points}`;
    const measurementLabel = (count: number) =>
      `${count} ${count === 1 ? measureCopy.measurement : measureCopy.measurements}`;

    const distanceStuds = (a: L.LatLng, b: L.LatLng) => Math.hypot(b.lng - a.lng, b.lat - a.lat);
    const pathLength = (points: L.LatLng[]) =>
      points.reduce(
        (total, point, index) => (index ? total + distanceStuds(points[index - 1], point) : 0),
        0
      );
    const polygonPerimeter = (points: L.LatLng[]) =>
      points.length >= 2 ? pathLength([...points, points[0]]) : 0;
    const polygonArea = (points: L.LatLng[]) => {
      if (points.length < 3) return 0;
      let area = 0;
      for (let index = 0; index < points.length; index += 1) {
        const a = points[index];
        const b = points[(index + 1) % points.length];
        area += a.lng * b.lat - b.lng * a.lat;
      }
      return Math.abs(area) / 2;
    };
    const polygonCentroid = (points: L.LatLng[]) => {
      if (!points.length) return null;
      let area = 0;
      let x = 0;
      let y = 0;
      for (let index = 0; index < points.length; index += 1) {
        const a = points[index];
        const b = points[(index + 1) % points.length];
        const factor = a.lng * b.lat - b.lng * a.lat;
        area += factor;
        x += (a.lng + b.lng) * factor;
        y += (a.lat + b.lat) * factor;
      }
      area /= 2;
      if (Math.abs(area) < 1e-6) {
        const sum = points.reduce(
          (acc, point) => ({ x: acc.x + point.lng, y: acc.y + point.lat }),
          { x: 0, y: 0 }
        );
        return L.latLng(sum.y / points.length, sum.x / points.length);
      }
      return L.latLng(y / (6 * area), x / (6 * area));
    };

    const measureUnit = (mode: MeasureMode) => (mode === 'area' ? areaUnit : distanceUnit);
    const measureUnits = (mode: MeasureMode) =>
      mode === 'area' ? measureCopy.areaUnits : measureCopy.distanceUnits;

    const makeMeasureLabel = (latlng: L.LatLng, text: string, extra = '') =>
      L.marker(latlng, {
        pane: 'pwMeasurePane',
        interactive: false,
        keyboard: false,
        icon: L.divIcon({
          className: 'pw-measure-label-wrap',
          html: `<span class="pw-measure-label ${extra}">${esc(text)}</span>`,
          iconSize: [0, 0],
          iconAnchor: [0, 0],
        }),
      });

    const addVertex = (point: L.LatLng) =>
      L.circleMarker(point, {
        pane: 'pwMeasurePane',
        radius: 4,
        color: '#10203a',
        weight: 2,
        fillColor: '#ffffff',
        fillOpacity: 1,
        interactive: false,
      });

    const drawPath = (path: MeasurePath) => {
      const { points, kind } = path;
      if (!points.length) return;

      const labels: L.Layer[] = [];

      if (kind === 'distance') {
        if (points.length >= 2) {
          measureLayer.addLayer(
            L.polyline(points, {
              pane: 'pwMeasurePane',
              color: '#10203a',
              weight: 7,
              opacity: 0.42,
              interactive: false,
            })
          );
          measureLayer.addLayer(
            L.polyline(points, {
              pane: 'pwMeasurePane',
              color: '#ffd24a',
              weight: 4,
              opacity: 0.95,
              lineCap: 'round',
              lineJoin: 'round',
              interactive: false,
            })
          );

          if (points.length > 2) {
            for (let index = 1; index < points.length; index += 1) {
              const a = points[index - 1];
              const b = points[index];
              const midpoint = L.latLng((a.lat + b.lat) / 2, (a.lng + b.lng) / 2);
              labels.push(
                makeMeasureLabel(midpoint, formatValue(distanceStuds(a, b), distanceUnit))
              );
            }
          }

          const total = pathLength(points);
          labels.push(
            makeMeasureLabel(
              points[points.length - 1],
              `${measureCopy.total}: ${formatValue(total, distanceUnit)}`,
              'is-total'
            )
          );
        }
      } else if (points.length >= 3) {
        measureLayer.addLayer(
          L.polygon(points, {
            pane: 'pwMeasurePane',
            color: '#ffd24a',
            weight: 3,
            opacity: 0.95,
            fillColor: '#ffd24a',
            fillOpacity: 0.18,
            interactive: false,
          })
        );
        const center = polygonCentroid(points);
        if (center) {
          labels.push(
            makeMeasureLabel(
              center,
              `${measureCopy.areaLabel}: ${formatValue(polygonArea(points), areaUnit)}`,
              'is-area'
            )
          );
        }
      } else if (points.length >= 2) {
        measureLayer.addLayer(
          L.polyline(points, {
            pane: 'pwMeasurePane',
            color: '#ffd24a',
            weight: 3,
            opacity: 0.95,
            interactive: false,
          })
        );
      }

      for (const point of points) measureLayer.addLayer(addVertex(point));
      for (const label of labels) measureLayer.addLayer(label);
    };

    const drawMeasurements = () => {
      measureLayer.clearLayers();
      for (const path of measurePaths) drawPath(path);
      if (measureActive) drawPath(measureActive);
      updateMeasurePanel();
    };

    let previewFrame = 0;
    let previewPoint: L.LatLng | null = null;

    const clearPreview = () => {
      previewPoint = null;
      previewLayer.clearLayers();
    };

    const drawPreview = (cursor: L.LatLng) => {
      previewLayer.clearLayers();
      if (!measureActive || !measureActive.points.length) return;

      const points = measureActive.points;
      const last = points[points.length - 1];

      if (measureActive.kind === 'distance') {
        previewLayer.addLayer(
          L.polyline([last, cursor], {
            pane: 'pwMeasurePane',
            color: '#ffd24a',
            weight: 3,
            opacity: 0.78,
            dashArray: '6 5',
            interactive: false,
          })
        );
        const midpoint = L.latLng((last.lat + cursor.lat) / 2, (last.lng + cursor.lng) / 2);
        previewLayer.addLayer(
          makeMeasureLabel(midpoint, formatValue(distanceStuds(last, cursor), distanceUnit), 'is-preview')
        );
      } else {
        const previewPoints = [...points, cursor];
        if (previewPoints.length >= 3) {
          previewLayer.addLayer(
            L.polygon(previewPoints, {
              pane: 'pwMeasurePane',
              color: '#ffd24a',
              weight: 2,
              opacity: 0.72,
              dashArray: '6 5',
              fillColor: '#ffd24a',
              fillOpacity: 0.1,
              interactive: false,
            })
          );
          const center = polygonCentroid(previewPoints);
          if (center) {
            previewLayer.addLayer(
              makeMeasureLabel(
                center,
                `${measureCopy.areaLabel}: ${formatValue(polygonArea(previewPoints), areaUnit)}`,
                'is-preview'
              )
            );
          }
        } else {
          previewLayer.addLayer(
            L.polyline(previewPoints, {
              pane: 'pwMeasurePane',
              color: '#ffd24a',
              weight: 2,
              opacity: 0.72,
              dashArray: '6 5',
              interactive: false,
            })
          );
        }
      }
    };

    const schedulePreview = (point: L.LatLng) => {
      previewPoint = point;
      if (previewFrame) return;
      previewFrame = requestAnimationFrame(() => {
        previewFrame = 0;
        if (previewPoint) drawPreview(previewPoint);
      });
    };

    const populateUnitSelect = () => {
      if (!measureUnitsSelect || !measureMode) return;
      const units = measureUnits(measureMode);
      if (measureUnitsSelect.dataset.mode !== measureMode) {
        measureUnitsSelect.innerHTML = units
          .map((unit) => `<option value="${unit.id}">${esc(unit.label)}</option>`)
          .join('');
        measureUnitsSelect.dataset.mode = measureMode;
      }
      measureUnitsSelect.value = measureUnit(measureMode).id;
    };

    const setMeasureCollapsed = (collapsed: boolean) => {
      measureCollapsed = collapsed;
      measurePanel?.classList.toggle('is-collapsed', collapsed);
      if (measureCollapse) {
        measureCollapse.setAttribute('aria-expanded', String(!collapsed));
        measureCollapse.setAttribute(
          'aria-label',
          collapsed ? measureCopy.expand : measureCopy.collapse
        );
        measureCollapse.setAttribute(
          'title',
          collapsed ? measureCopy.expand : measureCopy.collapse
        );
      }
    };

    const updateMeasurePanel = () => {
      if (!measurePanel || !measureMode) return;
      if (measureTitle) {
        measureTitle.textContent =
          measureMode === 'distance' ? measureCopy.distance : measureCopy.area;
      }
      populateUnitSelect();

      const unit = measureUnit(measureMode);
      const minimum = measureMode === 'distance' ? 2 : 3;
      const activePoints = measureActive?.points ?? [];
      const completed = measurePaths.filter((path) => path.kind === measureMode);
      const completedCount = completed.length;

      let label = measureCopy.total;
      let value = '—';
      let alt = measureCopy.empty;
      let hint = measureCopy.start;

      if (activePoints.length) {
        if (measureMode === 'distance') {
          if (activePoints.length >= 2) {
            const total = pathLength(activePoints);
            const conversions: string[] = [];
            if (unit.id !== 'studs') conversions.push(formatValue(total, studsUnit));
            if (unit.id !== 'meters') conversions.push(formatValue(total, metersUnit));
            if (!conversions.length) conversions.push(formatValue(total, feetUnit));
            value = formatValue(total, unit);
            alt = conversions.join(' · ');
          } else {
            value = pointLabel(activePoints.length);
            alt = measureCopy.addPoints;
          }
          hint = measureCopy.hint;
        } else if (activePoints.length >= 3) {
          const area = polygonArea(activePoints);
          const perimeter = polygonPerimeter(activePoints);
          label = measureCopy.areaLabel;
          value = formatValue(area, unit);
          alt = `${measureCopy.perimeter}: ${formatValue(perimeter, studsUnit)} · ${formatValue(perimeter, metersUnit)}`;
          hint = measureCopy.hint;
        } else {
          value = pointLabel(activePoints.length);
          alt = measureCopy.needPoints;
          hint = measureCopy.hint;
        }
      } else if (completedCount) {
        if (measureMode === 'distance') {
          const total = completed.reduce((sum, path) => sum + pathLength(path.points), 0);
          value = formatValue(total, unit);
        } else {
          const total = completed.reduce((sum, path) => sum + polygonArea(path.points), 0);
          value = formatValue(total, unit);
        }
        label = measureCopy.completed;
        alt = measurementLabel(completedCount);
        hint = measureCopy.addPoints;
      }

      if (measureReadoutLabel) measureReadoutLabel.textContent = label;
      if (measureValue) measureValue.textContent = value;
      if (measureAlt) measureAlt.textContent = alt;
      if (measureHint) measureHint.textContent = hint;
      if (measureFinish) measureFinish.disabled = !(measureActive && activePoints.length >= minimum);
      if (measureUndo) {
        measureUndo.disabled = !(measureActive && activePoints.length > 0) && !measurePaths.length;
      }
      if (measureClear) measureClear.disabled = !measureActive && !measurePaths.length;

      for (const tool of measureToolButtons) {
        const active = tool.dataset.measureMode === measureMode;
        tool.classList.toggle('is-active', active);
        tool.setAttribute('aria-pressed', String(active));
      }
    };

    const commitActive = () => {
      if (!measureActive) return;
      const minimum = measureActive.kind === 'distance' ? 2 : 3;
      if (measureActive.points.length >= minimum) measurePaths.push(measureActive);
      measureActive = null;
      clearPreview();
    };

    const startMeasure = (mode: MeasureMode, seed?: L.LatLng) => {
      commitActive();
      const wasHidden = measurePanel?.hidden ?? true;
      measureMode = mode;
      measureActive = { kind: mode, points: seed ? [seed] : [] };
      if (measurePanel) measurePanel.hidden = false;
      if (wasHidden) setMeasureCollapsed(measureBreakpoint.matches);
      root?.classList.add('is-measuring');
      map.doubleClickZoom.disable();
      map.closePopup();
      clearPreview();
      drawMeasurements();
    };

    const exitMeasure = () => {
      commitActive();
      measureMode = null;
      measureActive = null;
      clearPreview();
      if (measurePanel) measurePanel.hidden = true;
      root?.classList.remove('is-measuring');
      map.doubleClickZoom.enable();
      for (const tool of measureToolButtons) {
        tool.classList.remove('is-active');
        tool.setAttribute('aria-pressed', 'false');
      }
      drawMeasurements();
    };

    const finishMeasure = () => {
      if (!measureActive) return;
      const minimum = measureActive.kind === 'distance' ? 2 : 3;
      if (measureActive.points.length < minimum) return;
      measurePaths.push(measureActive);
      measureActive = null;
      clearPreview();
      drawMeasurements();
    };

    const undoMeasure = () => {
      if (measureActive?.points.length) measureActive.points.pop();
      else if (measurePaths.length) measurePaths.pop();
      clearPreview();
      drawMeasurements();
    };

    const clearMeasure = () => {
      measurePaths.length = 0;
      measureActive = null;
      clearPreview();
      drawMeasurements();
    };

    let lastMeasureClick: L.LatLng | null = null;
    let lastMeasureClickTime = 0;

    map.on('click', (event) => {
      if (!measureMode) return;
      const now = Date.now();
      if (lastMeasureClick && now - lastMeasureClickTime < 400) {
        const previous = map.latLngToContainerPoint(lastMeasureClick);
        const current = map.latLngToContainerPoint(event.latlng);
        if (previous.distanceTo(current) < 5) {
          lastMeasureClick = event.latlng;
          lastMeasureClickTime = now;
          return;
        }
      }
      lastMeasureClick = event.latlng;
      lastMeasureClickTime = now;
      if (!measureActive) measureActive = { kind: measureMode, points: [] };
      measureActive.points.push(event.latlng);
      clearPreview();
      drawMeasurements();
    });

    map.on('dblclick', () => {
      if (measureMode) finishMeasure();
    });

    map.on('mousemove', (event) => {
      if (!measureMode || !measureActive || !measureActive.points.length) return;
      schedulePreview(event.latlng);
    });

    map.on('mouseout', () => clearPreview());

    for (const tool of measureToolButtons) {
      tool.addEventListener('click', () => {
        const mode = tool.dataset.measureMode as MeasureMode | undefined;
        if (!mode) return;
        if (measureMode === mode && measurePanel && !measurePanel.hidden) {
          exitMeasure();
          return;
        }
        startMeasure(mode);
      });
    }

    measureClose?.addEventListener('click', exitMeasure);
    measureCollapse?.addEventListener('click', () => setMeasureCollapsed(!measureCollapsed));
    measureBreakpoint.addEventListener('change', (event) => {
      if (measureMode) setMeasureCollapsed(event.matches);
    });
    measureFinish?.addEventListener('click', finishMeasure);
    measureUndo?.addEventListener('click', undoMeasure);
    measureClear?.addEventListener('click', clearMeasure);
    measureUnitsSelect?.addEventListener('change', () => {
      if (!measureMode) return;
      const units = measureUnits(measureMode);
      const unit = units.find((item) => item.id === measureUnitsSelect.value) ?? units[0];
      if (measureMode === 'area') areaUnit = unit;
      else distanceUnit = unit;
      drawMeasurements();
      if (previewPoint) drawPreview(previewPoint);
    });

    document.addEventListener('keydown', (event) => {
      if (!measureMode) return;
      if (event.key === 'Escape') {
        if (measureActive?.points.length) {
          measureActive = null;
          clearPreview();
          drawMeasurements();
        } else {
          exitMeasure();
        }
      }
      if (event.key === 'Enter') finishMeasure();
    });

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        category = button.dataset.mapFilter ?? 'all';
        for (const other of filterButtons) {
          const active = other === button;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-pressed', String(active));
        }
        render();
      });
    }

    search?.addEventListener('input', () => {
      query = search.value;
      render();
    });

    document.addEventListener('click', (event) => {
      const measureButton = (event.target as Element).closest<HTMLButtonElement>('[data-measure-poi]');
      if (measureButton) {
        const id = measureButton.dataset.measurePoi;
        const poi = id ? poiById.get(id) : null;
        if (poi) {
          map.closePopup();
          startMeasure('distance', L.latLng(-poi.z, poi.x));
        }
        return;
      }

      const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy-poi]');
      if (!button) return;
      const id = button.dataset.copyPoi;
      if (!id) return;
      const url = `${window.location.origin}${window.location.pathname}?poi=${encodeURIComponent(id)}`;
      const done = () => {
        const original = button.innerHTML;
        button.textContent = data.labels.copied;
        window.setTimeout(() => {
          button.innerHTML = original;
        }, 1600);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(done);
      } else {
        done();
      }
    });

    map.on('popupopen', () => root?.classList.add('is-poi-open'));
    map.on('popupclose', () => {
      root?.classList.remove('is-poi-open');
      setActive(null);
    });
    map.on('move zoom resize viewreset moveend zoomend', scheduleLabelUpdate);

    render();

    const initialId = new URLSearchParams(window.location.search).get('poi');
    if (initialId) {
      const poi = poiById.get(initialId);
      if (poi) {
        focusPoi(poi, false);
        setUrlForPoi(poi);
      }
    }

    if ('fonts' in document) {
      document.fonts.ready.then(() => {
        measureLabels();
        scheduleLabelUpdate();
      });
    }

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(() => {
        const atOverview = map.getZoom() <= map.getMinZoom() + 0.01;
        map.invalidateSize();
        if (atOverview) fitMap();
        scheduleLabelUpdate();
      });
      observer.observe(canvas);
    }
  }
