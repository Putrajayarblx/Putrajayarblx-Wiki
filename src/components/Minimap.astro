const STUD_METERS = 0.28;

const distanceUnits = {
  en: [
    { id: 'studs', label: 'Studs', short: 'studs', factor: 1, decimals: 1 },
    { id: 'meters', label: 'Meters', short: 'm', factor: STUD_METERS, decimals: 2 },
    {
      id: 'feet',
      label: 'Feet',
      short: 'ft',
      factor: STUD_METERS * 3.280839895013123,
      decimals: 1,
    },
    { id: 'kilometers', label: 'Kilometres', short: 'km', factor: STUD_METERS / 1000, decimals: 3 },
    { id: 'miles', label: 'Miles', short: 'mi', factor: STUD_METERS / 1609.344, decimals: 3 },
  ],
  ms: [
    { id: 'studs', label: 'Stud', short: 'stud', factor: 1, decimals: 1 },
    { id: 'meters', label: 'Meter', short: 'm', factor: STUD_METERS, decimals: 2 },
    {
      id: 'feet',
      label: 'Kaki',
      short: 'ft',
      factor: STUD_METERS * 3.280839895013123,
      decimals: 1,
    },
    { id: 'kilometers', label: 'Kilometer', short: 'km', factor: STUD_METERS / 1000, decimals: 3 },
    { id: 'miles', label: 'Batu', short: 'mi', factor: STUD_METERS / 1609.344, decimals: 3 },
  ],
};

const areaUnits = {
  en: [
    { id: 'sqStuds', label: 'Square studs', short: 'stud²', factor: 1, decimals: 0 },
    { id: 'sqMeters', label: 'Square metres', short: 'm²', factor: STUD_METERS ** 2, decimals: 1 },
    {
      id: 'sqFeet',
      label: 'Square feet',
      short: 'ft²',
      factor: STUD_METERS ** 2 * 10.763910416709722,
      decimals: 0,
    },
    {
      id: 'hectares',
      label: 'Hectares',
      short: 'ha',
      factor: (STUD_METERS ** 2) / 10000,
      decimals: 2,
    },
    {
      id: 'acres',
      label: 'Acres',
      short: 'ac',
      factor: (STUD_METERS ** 2) / 4046.8564224,
      decimals: 2,
    },
    {
      id: 'sqKilometers',
      label: 'Square kilometres',
      short: 'km²',
      factor: (STUD_METERS ** 2) / 1e6,
      decimals: 3,
    },
  ],
  ms: [
    { id: 'sqStuds', label: 'Stud persegi', short: 'stud²', factor: 1, decimals: 0 },
    { id: 'sqMeters', label: 'Meter persegi', short: 'm²', factor: STUD_METERS ** 2, decimals: 1 },
    {
      id: 'sqFeet',
      label: 'Kaki persegi',
      short: 'ft²',
      factor: STUD_METERS ** 2 * 10.763910416709722,
      decimals: 0,
    },
    {
      id: 'hectares',
      label: 'Hektar',
      short: 'ha',
      factor: (STUD_METERS ** 2) / 10000,
      decimals: 2,
    },
    {
      id: 'acres',
      label: 'Ekar',
      short: 'ac',
      factor: (STUD_METERS ** 2) / 4046.8564224,
      decimals: 2,
    },
    {
      id: 'sqKilometers',
      label: 'Kilometer persegi',
      short: 'km²',
      factor: (STUD_METERS ** 2) / 1e6,
      decimals: 3,
    },
  ],
};

const categoryLabels: Record<'en' | 'ms', Record<string, string>> = {
  en: {
    all: 'All',
    government: 'Government',
    emergency: 'Emergency',
    services: 'Services',
    transport: 'Transport',
    landmarks: 'Landmarks',
    parks: 'Parks',
    other: 'Other',
  },
  ms: {
    all: 'Semua',
    government: 'Kerajaan',
    emergency: 'Kecemasan',
    services: 'Perkhidmatan',
    transport: 'Pengangkutan',
    landmarks: 'Mercu tanda',
    parks: 'Taman',
    other: 'Lain-lain',
  },
};

const typeLabels: Record<'en' | 'ms', Record<string, string>> = {
  en: {
    GovtMarker: 'Government',
    SecurityMarker: 'Police',
    FireDeptMarker: 'Fire & rescue',
    HospitalMarker: 'Health',
    ShopMarker: 'Shop',
    DealershipMarker: 'Dealership',
    MailOfficeMarker: 'Post office',
    BusStopMarker: 'Bus stop',
    BoatStopMarker: 'Boat stop',
    ParkingMarker: 'Parking',
    BridgeMarker: 'Bridge',
    MosqueMarker: 'Mosque',
    TouristMarker: 'Landmark',
    ParkMarker: 'Park',
    VenueMarker: 'Venue',
    Marker: 'Point of interest',
  },
  ms: {
    GovtMarker: 'Kerajaan',
    SecurityMarker: 'Polis',
    FireDeptMarker: 'Bomba & penyelamat',
    HospitalMarker: 'Kesihatan',
    ShopMarker: 'Kedai',
    DealershipMarker: 'Pengedar kereta',
    MailOfficeMarker: 'Pejabat pos',
    BusStopMarker: 'Hentian bas',
    BoatStopMarker: 'Hentian bot',
    ParkingMarker: 'Parkir',
    BridgeMarker: 'Jambatan',
    MosqueMarker: 'Masjid',
    TouristMarker: 'Mercu tanda',
    ParkMarker: 'Taman',
    VenueMarker: 'Tempat acara',
    Marker: 'Tempat menarik',
  },
};

const iconFiles: Record<string, string> = {
  BoatStopMarker: 'MapBoat.png',
  BridgeMarker: 'MapBridge.png',
  BusStopMarker: 'MapBus.png',
  DealershipMarker: 'MapDealership.png',
  FireDeptMarker: 'MapFireDept.png',
  GovtMarker: 'MapGovt.png',
  HospitalMarker: 'MapHospital.png',
  MailOfficeMarker: 'MapMail.png',
  MosqueMarker: 'MapMosque.png',
  ParkMarker: 'MapPark.png',
  ParkingMarker: 'MapParking.png',
  SecurityMarker: 'MapSecurity.png',
  ShopMarker: 'MapShop.png',
  TouristMarker: 'MapTourist.png',
  VenueMarker: 'MapVenue.png',
};

const categories = Object.entries(categoryLabels[locale]).map(([id, label]) => ({ id, label }));

const drawColours = [
  { value: '#ffd24a', en: 'Yellow', ms: 'Kuning' },
  { value: '#ff5a5f', en: 'Red', ms: 'Merah' },
  { value: '#4cc9f0', en: 'Cyan', ms: 'Sian' },
  { value: '#7ae582', en: 'Green', ms: 'Hijau' },
  { value: '#ffffff', en: 'White', ms: 'Putih' },
  { value: '#10203a', en: 'Navy', ms: 'Biru gelap' },
];

const localizedPois = pois.map((poi) => {
  const typeLabel = typeLabels[locale][poi.t] ?? poi.catLabel;
  let label = poi.label;
  if (locale !== 'en' && !poi.n?.trim()) {
    const number = poi.label.match(/(\d+)$/)?.[0];
    label = number ? `${typeLabel} ${number}` : typeLabel;
  }
  return {
    ...poi,
    label,
    catLabel: typeLabel,
    iconFile: iconFiles[poi.t] ?? 'generic',
  };
});

const counts = Object.fromEntries(
  categories.map((category) => [
    category.id,
    category.id === 'all'
      ? localizedPois.length
      : localizedPois.filter((poi) => poi.cat === category.id).length,
  ])
);

const payload = JSON.stringify({
  bounds,
  pois: localizedPois,
  labels: {
    copyLink: strings.copyLink,
    copied: strings.copied,
    mapAlt: strings.mapAlt,
    zoomIn: strings.zoomIn,
    zoomOut: strings.zoomOut,
  },
  measure: {
    ...strings.measure,
    distanceUnits: distanceUnits[locale],
    areaUnits: areaUnits[locale],
  },
  draw: strings.draw,
  download: strings.download,
});
---

<div class="not-content pw-map" data-pw-map>
  <div class="pw-map__canvas" data-map-canvas aria-label={strings.mapLabel}></div>

  <div class="pw-map__overlay">
    <label class="pw-map__search">
      <span class="sr-only">{strings.searchLabel}</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.5-3.5"></path>
      </svg>
      <input type="search" placeholder={strings.searchPlaceholder} autocomplete="off" data-map-search />
    </label>

    <button
      type="button"
      class="pw-map__filter-toggle"
      data-filter-toggle
      aria-expanded="false"
      aria-controls="pw-map-filters"
      title={strings.filterLabel}
    >
      <span class="sr-only">{strings.filterLabel}</span>
      <svg class="pw-filter-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3 5h18l-7 8v6l-4 2v-8L3 5Z"></path>
      </svg>
      <span data-filter-toggle-label>{categories[0].label} {counts.all}</span>
      <svg class="pw-filter-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="m6 9 6 6 6-6"></path>
      </svg>
    </button>

    <div class="pw-map__filters" id="pw-map-filters" data-map-filters role="group" aria-label={strings.filterLabel}>
      {
        categories.map((category, index) => (
          <button
            type="button"
            class:list={{ 'is-active': index === 0 }}
            data-map-filter={category.id}
            data-category-label={category.label}
            aria-pressed={index === 0 ? 'true' : 'false'}
          >
            {category.label}
            <span>{counts[category.id]}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="pw-measure" data-pw-measure>
    <div class="pw-measure__panel" data-measure-panel role="group" aria-label={strings.measure.title} hidden>
      <div class="pw-measure__head">
        <strong data-measure-title>{strings.measure.distance}</strong>
        <span class="pw-measure__head-actions">
          <button
            type="button"
            class="pw-measure__collapse"
            data-measure-collapse
            aria-expanded="true"
            aria-label={strings.measure.collapse}
            title={strings.measure.collapse}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 9 6 6 6-6"></path>
            </svg>
          </button>
          <button
            type="button"
            class="pw-measure__close"
            data-measure-close
            aria-label={strings.measure.close}
            title={strings.measure.close}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="m6 6 12 12M18 6 6 18"></path>
            </svg>
          </button>
        </span>
      </div>

      <label class="pw-measure__units">
        <span>{strings.measure.units}</span>
        <select data-measure-units></select>
      </label>

      <div class="pw-measure__readout">
        <span class="pw-measure__readout-label" data-measure-readout-label>{strings.measure.total}</span>
        <strong data-measure-value>—</strong>
        <small data-measure-alt></small>
      </div>

      <p class="pw-measure__hint" data-measure-hint>{strings.measure.start}</p>

      <div class="pw-measure__actions">
        <button type="button" data-measure-undo disabled>{strings.measure.undo}</button>
        <button type="button" class="is-primary" data-measure-finish disabled>{strings.measure.finish}</button>
        <button type="button" data-measure-clear disabled>{strings.measure.clear}</button>
      </div>

      <p class="pw-measure__note">{strings.measure.studNote}</p>
    </div>

    <div class="pw-draw__panel" data-draw-panel role="group" aria-label={strings.draw.title} hidden>
      <div class="pw-draw__head">
        <span class="pw-draw__heading">
          <span class="pw-draw__eyebrow">{strings.draw.title}</span>
          <strong data-draw-title>{strings.draw.free}</strong>
        </span>
        <button
          type="button"
          class="pw-draw__close"
          data-draw-close
          aria-label={strings.draw.close}
          title={strings.draw.close}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <div class="pw-draw__colours" role="group" aria-label={strings.draw.colour}>
        <span class="pw-draw__label">{strings.draw.colour}</span>
        <div class="pw-draw__swatches">
          {
            drawColours.map((colour) => (
              <button
                type="button"
                class:list={{ 'is-active': colour.value === '#ffd24a' }}
                data-draw-colour={colour.value}
                style={`--swatch:${colour.value}`}
                aria-label={locale === 'ms' ? colour.ms : colour.en}
                aria-pressed={colour.value === '#ffd24a' ? 'true' : 'false'}
                title={locale === 'ms' ? colour.ms : colour.en}
              ></button>
            ))
          }
        </div>
      </div>

      <div class="pw-draw__widths" role="group" aria-label={strings.draw.width}>
        <span class="pw-draw__label">{strings.draw.width}</span>
        <div class="pw-draw__width-buttons">
          <button type="button" data-draw-width="3" aria-pressed="false">{strings.draw.thin}</button>
          <button type="button" class="is-active" data-draw-width="6" aria-pressed="true">
            {strings.draw.medium}
          </button>
          <button type="button" data-draw-width="10" aria-pressed="false">{strings.draw.thick}</button>
        </div>
      </div>

      <p class="pw-draw__hint" data-draw-hint>{strings.draw.hintFree}</p>

      <div class="pw-draw__actions">
        <button type="button" data-draw-undo disabled>{strings.draw.undo}</button>
        <button type="button" class="is-primary" data-draw-finish>{strings.draw.finish}</button>
        <button type="button" data-draw-clear disabled>{strings.draw.clear}</button>
      </div>
    </div>

    <div class="pw-measure__tools" role="group" aria-label={strings.toolsLabel}>
      <button
        type="button"
        class="pw-measure__tool pw-measure__tools-toggle"
        data-tools-toggle
        aria-expanded="false"
        aria-label={strings.toolsLabel}
        title={strings.toolsLabel}
      >
        <svg class="pw-tools-open-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h7M15 18h5"></path>
          <circle cx="15" cy="6" r="2"></circle>
          <circle cx="9" cy="12" r="2"></circle>
          <circle cx="13" cy="18" r="2"></circle>
        </svg>
        <svg class="pw-tools-close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>

      <button
        type="button"
        class="pw-measure__tool"
        data-measure-mode="distance"
        aria-pressed="false"
        aria-label={strings.measure.distance}
        title={strings.measure.distance}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 17 17 4l3 3L7 20l-3-3Z"></path>
          <path d="m7 14 2 2M10 11l2 2M13 8l2 2"></path>
        </svg>
      </button>
      <button
        type="button"
        class="pw-measure__tool"
        data-measure-mode="area"
        aria-pressed="false"
        aria-label={strings.measure.area}
        title={strings.measure.area}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 7.5 12 3l8 5-2 10-10 2-4-8.5Z"></path>
          <circle cx="4" cy="7.5" r="1.3" fill="currentColor" stroke="none"></circle>
          <circle cx="12" cy="3" r="1.3" fill="currentColor" stroke="none"></circle>
          <circle cx="20" cy="8" r="1.3" fill="currentColor" stroke="none"></circle>
          <circle cx="18" cy="18" r="1.3" fill="currentColor" stroke="none"></circle>
          <circle cx="8" cy="20" r="1.3" fill="currentColor" stroke="none"></circle>
        </svg>
      </button>
      <button
        type="button"
        class="pw-measure__tool pw-measure__tool--pois"
        data-pois-toggle
        aria-pressed="false"
        aria-label={strings.measure.hidePois}
        title={strings.measure.hidePois}
      >
        <svg class="pw-pois-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
          <circle cx="12" cy="12" r="2.6"></circle>
        </svg>
        <svg class="pw-pois-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m3 3 18 18"></path>
          <path d="M10.6 6.2A10.6 10.6 0 0 1 12 6c6.5 0 10 6 10 6a17.5 17.5 0 0 1-3.1 3.7"></path>
          <path d="M6.2 6.7C3.6 8.3 2 12 2 12s3.5 6 10 6a10.6 10.6 0 0 0 5.1-1.3"></path>
          <path d="M9.8 9.8a3 3 0 0 0 4.4 4.4"></path>
        </svg>
      </button>

      <span class="pw-measure__divider" aria-hidden="true"></span>

      <button
        type="button"
        class="pw-measure__tool"
        data-draw-mode="free"
        aria-pressed="false"
        aria-label={strings.draw.free}
        title={strings.draw.free}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 20l4.6-1 9.9-9.9a2.1 2.1 0 0 0-3-3L5.6 16 4 20Z"></path>
          <path d="m13.5 6.5 3 3"></path>
        </svg>
      </button>

      <button
        type="button"
        class="pw-measure__tool"
        data-draw-mode="line"
        aria-pressed="false"
        aria-label={strings.draw.line}
        title={strings.draw.line}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 19 19 5"></path>
          <circle cx="5" cy="19" r="2"></circle>
          <circle cx="19" cy="5" r="2"></circle>
        </svg>
      </button>

      <span class="pw-measure__divider" aria-hidden="true"></span>

      <button
        type="button"
        class="pw-measure__tool pw-measure__tool--download"
        data-download-open
        aria-label={strings.download.title}
        title={strings.download.title}
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3v12"></path>
          <path d="m7 10 5 5 5-5"></path>
          <path d="M5 20h14"></path>
        </svg>
      </button>

      <button
        type="button"
        class="pw-measure__tool pw-measure__tool--fullscreen"
        data-fullscreen-toggle
        data-label-enter={strings.fullscreen}
        data-label-exit={strings.exitFullscreen}
        aria-pressed="false"
        aria-label={strings.fullscreen}
        title={strings.fullscreen}
      >
        <svg class="pw-fullscreen-enter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 4H4v5"></path>
          <path d="M15 4h5v5"></path>
          <path d="M20 15v5h-5"></path>
          <path d="M4 15v5h5"></path>
        </svg>
        <svg class="pw-fullscreen-exit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M4 9h5V4"></path>
          <path d="M20 9h-5V4"></path>
          <path d="M20 15h-5v5"></path>
          <path d="M4 15h5v5"></path>
        </svg>
      </button>
    </div>

    <button
      type="button"
      class="pw-measure__tool pw-measure__tool--fullscreen pw-measure__tool--fullscreen-float"
      data-fullscreen-toggle
      data-label-enter={strings.fullscreen}
      data-label-exit={strings.exitFullscreen}
      aria-pressed="false"
      aria-label={strings.fullscreen}
      title={strings.fullscreen}
    >
      <svg class="pw-fullscreen-enter" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M9 4H4v5"></path>
        <path d="M15 4h5v5"></path>
        <path d="M20 15v5h-5"></path>
        <path d="M4 15v5h5"></path>
      </svg>
      <svg class="pw-fullscreen-exit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 9h5V4"></path>
        <path d="M20 9h-5V4"></path>
        <path d="M20 15h-5v5"></path>
        <path d="M4 15h5v5"></path>
      </svg>
    </button>
  </div>

  <dialog class="pw-download" data-download-dialog aria-labelledby="pw-download-title">
    <form method="dialog" class="pw-download__form" data-download-form>
      <div class="pw-download__head">
        <div>
          <h2 id="pw-download-title">{strings.download.title}</h2>
        </div>
        <button
          type="button"
          class="pw-download__close"
          data-download-close
          aria-label={strings.draw.close}
          title={strings.draw.close}
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18"></path>
          </svg>
        </button>
      </div>

      <p class="pw-download__note">{strings.download.note}</p>

      <fieldset class="pw-download__modes">
        <legend>{strings.download.places}</legend>
        <div class="pw-download__mode-list">
          <label>
            <input type="radio" name="pw-download-places" value="all" checked />
            <span>{strings.download.all}</span>
          </label>
          <label>
            <input type="radio" name="pw-download-places" value="none" />
            <span>{strings.download.none}</span>
          </label>
          <label>
            <input type="radio" name="pw-download-places" value="selected" />
            <span>{strings.download.selected}</span>
          </label>
        </div>
      </fieldset>

      <div class="pw-download__picker" data-download-picker hidden>
        <label class="pw-download__search">
          <span class="sr-only">{strings.download.search}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
          <input type="search" placeholder={strings.download.search} autocomplete="off" data-download-search />
        </label>

        <div class="pw-download__picker-tools">
          <button type="button" data-download-select-all>{strings.download.selectAll}</button>
          <button type="button" data-download-clear>{strings.download.clear}</button>
          <span data-download-count aria-live="polite"></span>
        </div>

        <div class="pw-download__list" data-download-list></div>
        <p class="pw-download__empty" data-download-empty hidden>{strings.download.empty}</p>
      </div>

      <p class="pw-download__error" data-download-error role="alert" hidden></p>

      <div class="pw-download__actions">
        <button type="button" class="pw-download__cancel" data-download-close>{strings.download.cancel}</button>
        <button type="button" class="pw-download__run" data-download-run>{strings.download.run}</button>
      </div>
    </form>
  </dialog>

  <p class="pw-map__empty" data-map-empty hidden>{strings.empty}</p>

  <p class="pw-map__hint">
    <span class="pw-map__hint-mouse">{strings.hintMouse}</span>
    <span class="pw-map__hint-touch">{strings.hintTouch}</span>
  </p>
</div>

<script type="application/json" id="pw-map-data" set:html={payload} />

<script>
  import L from 'leaflet';

  const root = document.querySelector<HTMLElement>('[data-pw-map]');
  const canvas = root?.querySelector<HTMLElement>('[data-map-canvas]');
  const search = root?.querySelector<HTMLInputElement>('[data-map-search]');
  const searchBox = root?.querySelector<HTMLElement>('.pw-map__search');
  const filters = root?.querySelector<HTMLElement>('[data-map-filters]');
  const empty = root?.querySelector<HTMLElement>('[data-map-empty]');
  const filterButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-map-filter]') ?? [])];
  const measurePanel = root?.querySelector<HTMLElement>('[data-measure-panel]');
  const measureTitle = root?.querySelector<HTMLElement>('[data-measure-title]');
  const measureUnitsSelect = root?.querySelector<HTMLSelectElement>('[data-measure-units]');
  const measureReadoutLabel = root?.querySelector<HTMLElement>('[data-measure-readout-label]');
  const measureValue = root?.querySelector<HTMLElement>('[data-measure-value]');
  const measureAlt = root?.querySelector<HTMLElement>('[data-measure-alt]');
  const measureHint = root?.querySelector<HTMLElement>('[data-measure-hint]');
  const measureUndo = root?.querySelector<HTMLButtonElement>('[data-measure-undo]');
  const measureFinish = root?.querySelector<HTMLButtonElement>('[data-measure-finish]');
  const measureClear = root?.querySelector<HTMLButtonElement>('[data-measure-clear]');
  const measureClose = root?.querySelector<HTMLButtonElement>('[data-measure-close]');
  const measureCollapse = root?.querySelector<HTMLButtonElement>('[data-measure-collapse]');
  const measureToolButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-measure-mode]') ?? [])];
  const poisToggle = root?.querySelector<HTMLButtonElement>('[data-pois-toggle]');
  const filterToggle = root?.querySelector<HTMLButtonElement>('[data-filter-toggle]');
  const filterToggleLabel = root?.querySelector<HTMLElement>('[data-filter-toggle-label]');
  const toolsToggle = root?.querySelector<HTMLButtonElement>('[data-tools-toggle]');

  const drawPanel = root?.querySelector<HTMLElement>('[data-draw-panel]');
  const drawTitle = root?.querySelector<HTMLElement>('[data-draw-title]');
  const drawHint = root?.querySelector<HTMLElement>('[data-draw-hint]');
  const drawUndo = root?.querySelector<HTMLButtonElement>('[data-draw-undo]');
  const drawFinish = root?.querySelector<HTMLButtonElement>('[data-draw-finish]');
  const drawClear = root?.querySelector<HTMLButtonElement>('[data-draw-clear]');
  const drawClose = root?.querySelector<HTMLButtonElement>('[data-draw-close]');
  const drawToolButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-draw-mode]') ?? [])];
  const drawColourButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-draw-colour]') ?? [])];
  const drawWidthButtons = [...(root?.querySelectorAll<HTMLButtonElement>('[data-draw-width]') ?? [])];

  const downloadOpen = root?.querySelector<HTMLButtonElement>('[data-download-open]');
  const downloadDialog = root?.querySelector<HTMLDialogElement>('[data-download-dialog]');
  const downloadPicker = root?.querySelector<HTMLElement>('[data-download-picker]');
  const downloadSearch = root?.querySelector<HTMLInputElement>('[data-download-search]');
  const downloadList = root?.querySelector<HTMLElement>('[data-download-list]');
  const downloadEmpty = root?.querySelector<HTMLElement>('[data-download-empty]');
  const downloadCount = root?.querySelector<HTMLElement>('[data-download-count]');
  const downloadRun = root?.querySelector<HTMLButtonElement>('[data-download-run]');
  const downloadError = root?.querySelector<HTMLElement>('[data-download-error]');
  const downloadSelectAll = root?.querySelector<HTMLButtonElement>('[data-download-select-all]');
  const downloadClear = root?.querySelector<HTMLButtonElement>('[data-download-clear]');
  const downloadModeInputs = [...(root?.querySelectorAll<HTMLInputElement>('input[name="pw-download-places"]') ?? [])];
  const fullscreenToggles = [...(root?.querySelectorAll<HTMLButtonElement>('[data-fullscreen-toggle]') ?? [])];

  const source = document.getElementById('pw-map-data');

  type Poi = {
    id: string;
    label: string;
    cat: string;
    catLabel: string;
    iconFile: string;
    textColor: string;
    poiColor: string;
    x: number;
    z: number;
  };

  type Unit = {
    id: string;
    label: string;
    short: string;
    factor: number;
    decimals: number;
  };

  type Data = {
    bounds: { minX: number; maxX: number; minZ: number; maxZ: number };
    pois: Poi[];
    labels: {
      copyLink: string;
      copied: string;
      mapAlt: string;
      zoomIn: string;
      zoomOut: string;
    };
    measure: {
      title: string;
      distance: string;
      area: string;
      units: string;
      finish: string;
      undo: string;
      clear: string;
      close: string;
      expand: string;
      collapse: string;
      hidePois: string;
      showPois: string;
      start: string;
      addPoints: string;
      hint: string;
      finishHint: string;
      needPoints: string;
      total: string;
      areaLabel: string;
      perimeter: string;
      completed: string;
      measurements: string;
      measurement: string;
      points: string;
      point: string;
      empty: string;
      fromPoi: string;
      studNote: string;
      distanceUnits: Unit[];
      areaUnits: Unit[];
    };
    draw: {
      title: string;
      free: string;
      line: string;
      colour: string;
      width: string;
      thin: string;
      medium: string;
      thick: string;
      hintFree: string;
      hintLine: string;
      undo: string;
      finish: string;
      clear: string;
      close: string;
      empty: string;
    };
    download: {
      title: string;
      places: string;
      all: string;
      none: string;
      selected: string;
      search: string;
      selectAll: string;
      clear: string;
      cancel: string;
      run: string;
      preparing: string;
      note: string;
      empty: string;
      selectedCount: string;
      selectedCountOne: string;
      error: string;
    };
  };

  type Rect = { left: number; top: number; right: number; bottom: number };
  type Side = 'right' | 'bottom' | 'left' | 'top';

  const LABEL_H = 18;
  const LABEL_GAP = 5;
  const ICON_HALF = 15;
  const PAD_X = 6;
  const PAD_Y = 3;
  const SIDES: Side[] = ['right', 'bottom', 'left', 'top'];

  if (root && canvas && source) {
    const data = JSON.parse(source.textContent || '{}') as Data;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const setFiltersOpen = (open: boolean) => {
      root?.classList.toggle('is-filters-open', open);
      filterToggle?.setAttribute('aria-expanded', String(open));
    };

    const setToolsOpen = (open: boolean) => {
      root?.classList.toggle('is-tools-open', open);
      toolsToggle?.setAttribute('aria-expanded', String(open));
    };

    const bounds = L.latLngBounds(
      [-data.bounds.maxZ, data.bounds.minX],
      [-data.bounds.minZ, data.bounds.maxX]
    );

    const map = L.map(canvas, {
      crs: L.CRS.Simple,
      minZoom: -6,
      maxZoom: 1,
      zoomSnap: 0.1,
      zoomDelta: 0.5,
      attributionControl: false,
      zoomControl: false,
      maxBoundsViscosity: 1,
      maxBounds: bounds.pad(0.25),
      zoomAnimation: !reduceMotion,
      fadeAnimation: !reduceMotion,
      markerZoomAnimation: !reduceMotion,
    });

    L.imageOverlay('/minimap.svg', bounds, {
      alt: data.labels.mapAlt,
    }).addTo(map);

    const fitMap = () => {
      map.fitBounds(bounds, { padding: [14, 14] });
      map.setMinZoom(map.getZoom());
    };
    fitMap();
    L.control.zoom({
      position: 'bottomright',
      zoomInTitle: data.labels.zoomIn,
      zoomOutTitle: data.labels.zoomOut,
    }).addTo(map);

    const markerLayer = L.layerGroup().addTo(map);
    const markerById = new Map<string, L.Marker>();
    const poiById = new Map(data.pois.map((poi) => [poi.id, poi]));
    const labelWidths = new Map<string, number>();
    let visiblePois: Poi[] = [];
    let activeId: string | null = null;
    let query = '';
    let category = 'all';

    const updateFilterToggle = () => {
      if (!filterToggleLabel) return;
      const active = filterButtons.find((button) => button.dataset.mapFilter === category);
      if (!active) return;
      const label = active.dataset.categoryLabel ?? '';
      const count = active.querySelector('span')?.textContent?.trim() ?? '';
      filterToggleLabel.textContent = count ? `${label} ${count}` : label;
      root?.classList.toggle('is-filtered', category !== 'all');
    };

    updateFilterToggle();

    const esc = (value: string) =>
      value.replace(/[&<>"']/g, (character) => {
        const entities: Record<string, string> = {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#39;',
        };
        return entities[character] ?? character;
      });

    const categoryTints: Record<string, string> = {
      government: '#355a9e',
      emergency: '#c4454f',
      services: '#c48b3f',
      transport: '#2c8a86',
      landmarks: '#9a5d9c',
      parks: '#4f8a55',
      other: '#5f6b7a',
    };

    const heroMarkup = (poi: Poi) => {
      if (poi.iconFile === 'generic') {
        const pinColor = esc(poi.poiColor || '#78909C');
        return `<svg class="pw-poi-card__img" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a7 7 0 0 0-7 7c0 4.6 7 12 7 12s7-7.4 7-12a7 7 0 0 0-7-7Z" fill="${pinColor}" stroke="#16233a" stroke-width="1.6"/><circle cx="12" cy="9.5" r="2.6" fill="#fff"/></svg>`;
      }
      return `<img class="pw-poi-card__img" src="/MapIcons/${poi.iconFile}" alt="" width="56" height="56" />`;
    };

    const popupHtml = (poi: Poi) => {
      const xPct = (poi.x - data.bounds.minX) / (data.bounds.maxX - data.bounds.minX);
      const yPct = (poi.z - data.bounds.minZ) / (data.bounds.maxZ - data.bounds.minZ);
      const heroWidth = 288;
      const heroHeight = 96;
      const scale = 9;
      const imageHeight = scale * heroWidth * (1245 / 2400);
      const bgX = ((0.5 - scale * xPct) / (1 - scale)) * 100;
      const bgY = ((0.5 - (imageHeight / heroHeight) * yPct) / (1 - imageHeight / heroHeight)) * 100;
      return `
        <div class="pw-poi-card" style="--poi-tint:${categoryTints[poi.cat] ?? '#5f6b7a'};--hero-x:${bgX}%;--hero-y:${bgY}%">
          <div class="pw-poi-card__hero" aria-hidden="true">
            <span class="pw-poi-card__map"></span>
            ${heroMarkup(poi)}
          </div>
          <div class="pw-poi-card__body">
            <span class="pw-poi-card__kind">${esc(poi.catLabel)}</span>
            <h3>${esc(poi.label)}</h3>
            <p class="pw-poi-card__coords">X ${poi.x.toFixed(1)} · Z ${poi.z.toFixed(1)}</p>
            <div class="pw-poi-card__actions">
              <button type="button" class="pw-poi-card__btn" data-copy-poi="${poi.id}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="9" y="9" width="10" height="10" rx="2"></rect><path d="M15 9V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path></svg>
                ${esc(data.labels.copyLink)}
              </button>
              <button type="button" class="pw-poi-card__btn pw-poi-card__btn--accent" data-measure-poi="${poi.id}">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17 17 4l3 3L7 20l-3-3Z"></path><path d="m7 14 2 2M10 11l2 2M13 8l2 2"></path></svg>
                ${esc(data.measure.fromPoi)}
              </button>
            </div>
          </div>
        </div>
      `;
    };

    const iconMarkup = (poi: Poi) => {
      if (poi.iconFile === 'generic') {
        const pinColor = esc(poi.poiColor || '#78909C');
        return `<svg class="pw-poi__icon pw-poi__icon--generic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a7 7 0 0 0-7 7c0 4.6 7 12 7 12s7-7.4 7-12a7 7 0 0 0-7-7Z" fill="${pinColor}" stroke="#16233a" stroke-width="2"/><circle cx="12" cy="9.5" r="2.6" fill="#fff"/></svg>`;
      }
      return `<img class="pw-poi__icon" src="/MapIcons/${poi.iconFile}" alt="" width="30" height="30" draggable="false" />`;
    };

    for (const poi of data.pois) {
      const marker = L.marker([-poi.z, poi.x], {
        icon: L.divIcon({
          className: 'pw-poi',
          html: `${iconMarkup(poi)}<span class="pw-poi__label" style="color:${esc(poi.textColor || '#FFFFFF')}">${esc(poi.label)}</span>`,
          iconSize: [30, 30],
          iconAnchor: [15, 15],
          popupAnchor: [0, -18],
        }),
        keyboard: true,
        riseOnHover: true,
      });

      marker.bindPopup(popupHtml(poi), {
        closeButton: false,
        className: 'pw-map-popup-wrap',
        maxWidth: 340,
        minWidth: 300,
      });
      marker.on('click', () => selectPoi(poi));
      markerById.set(poi.id, marker);
    }

    const setActive = (id: string | null) => {
      activeId = id;
      for (const [poiId, marker] of markerById) {
        const el = marker.getElement();
        if (el) el.classList.toggle('is-active', poiId === id);
      }
    };

    const setUrl = (poi: Poi | null) => {
      const url = new URL(window.location.href);
      if (poi) url.searchParams.set('poi', poi.id);
      else url.searchParams.delete('poi');
      history.replaceState(null, '', url);
    };

    const measureLabels = () => {
      for (const [id, marker] of markerById) {
        const label = marker.getElement()?.querySelector<HTMLElement>('.pw-poi__label');
        if (label) labelWidths.set(id, Math.ceil(label.offsetWidth));
      }
    };

    const overlaps = (a: Rect, b: Rect) =>
      a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;

    const labelRect = (side: Side, cx: number, cy: number, width: number): Rect => {
      if (side === 'right') {
        return {
          left: cx + ICON_HALF + LABEL_GAP,
          top: cy - LABEL_H / 2 - PAD_Y,
          right: cx + ICON_HALF + LABEL_GAP + width + PAD_X,
          bottom: cy + LABEL_H / 2 + PAD_Y,
        };
      }
      if (side === 'left') {
        return {
          left: cx - ICON_HALF - LABEL_GAP - width - PAD_X,
          top: cy - LABEL_H / 2 - PAD_Y,
          right: cx - ICON_HALF - LABEL_GAP,
          bottom: cy + LABEL_H / 2 + PAD_Y,
        };
      }
      if (side === 'bottom') {
        return {
          left: cx - width / 2 - PAD_X,
          top: cy + ICON_HALF + LABEL_GAP,
          right: cx + width / 2 + PAD_X,
          bottom: cy + ICON_HALF + LABEL_GAP + LABEL_H + PAD_Y * 2,
        };
      }
      return {
        left: cx - width / 2 - PAD_X,
        top: cy - ICON_HALF - LABEL_GAP - LABEL_H - PAD_Y * 2,
        right: cx + width / 2 + PAD_X,
        bottom: cy - ICON_HALF - LABEL_GAP,
      };
    };

    const updateLabels = () => {
      const width = canvas.clientWidth;
      const height = canvas.clientHeight;
      if (!width || !height) return;

      const canvasRect = canvas.getBoundingClientRect();
      const blocked: Rect[] = [];
      for (const el of [searchBox, filters]) {
        if (!el) continue;
        const r = el.getBoundingClientRect();
        blocked.push({
          left: r.left - canvasRect.left - 2,
          top: r.top - canvasRect.top - 2,
          right: r.right - canvasRect.left + 2,
          bottom: r.bottom - canvasRect.top + 2,
        });
      }

      const icons: Rect[] = [];
      const entries: { poi: Poi; el: HTMLElement; cx: number; cy: number }[] = [];
      for (const poi of visiblePois) {
        const marker = markerById.get(poi.id);
        const el = marker?.getElement();
        if (!el) continue;
        const point = map.latLngToContainerPoint([-poi.z, poi.x]);
        icons.push({
          left: point.x - ICON_HALF,
          top: point.y - ICON_HALF,
          right: point.x + ICON_HALF,
          bottom: point.y + ICON_HALF,
        });
        entries.push({ poi, el, cx: point.x, cy: point.y });
      }

      const centerX = width / 2;
      const centerY = height / 2;
      entries.sort(
        (a, b) =>
          (a.cx - centerX) ** 2 +
          (a.cy - centerY) ** 2 -
          ((b.cx - centerX) ** 2 + (b.cy - centerY) ** 2)
      );

      const placed: Rect[] = [];
      for (const entry of entries) {
        const labelWidth = labelWidths.get(entry.poi.id) ?? 0;
        let chosen: Side | null = null;

        if (labelWidth > 0) {
          for (const side of SIDES) {
            const rect = labelRect(side, entry.cx, entry.cy, labelWidth);
            if (rect.left < 0 || rect.top < 0 || rect.right > width || rect.bottom > height) continue;
            if (blocked.some((b) => overlaps(rect, b))) continue;
            if (icons.some((i) => overlaps(rect, i))) continue;
            if (placed.some((p) => overlaps(rect, p))) continue;
            chosen = side;
            placed.push(rect);
            break;
          }
        }

        if (chosen) entry.el.dataset.labelSide = chosen;
        else delete entry.el.dataset.labelSide;
      }
    };

    let labelFrame = 0;
    const scheduleLabelUpdate = () => {
      if (labelFrame) return;
      labelFrame = requestAnimationFrame(() => {
        labelFrame = 0;
        updateLabels();
      });
    };

    const render = () => {
      const needle = query.trim().toLowerCase();
      const visible = data.pois.filter((poi) => {
        const matchesCategory = category === 'all' || poi.cat === category;
        const matchesQuery =
          !needle ||
          poi.label.toLowerCase().includes(needle) ||
          poi.catLabel.toLowerCase().includes(needle);
        return matchesCategory && matchesQuery;
      });
      visiblePois = visible;

      markerLayer.clearLayers();
      for (const poi of visible) {
        const marker = markerById.get(poi.id);
        if (!marker) continue;
        markerLayer.addLayer(marker);
        const el = marker.getElement();
        if (el) {
          el.setAttribute('aria-label', poi.label);
          el.setAttribute('role', 'button');
        }
      }

      if (empty) empty.hidden = visible.length > 0;
      if (activeId && !visible.some((poi) => poi.id === activeId)) {
        map.closePopup();
        setActive(null);
        setUrl(null);
      }

      measureLabels();
      updateLabels();
    };

    const setUrlForPoi = (poi: Poi) => setUrl(poi);

    const selectPoi = (poi: Poi) => {
      setActive(poi.id);
      setUrlForPoi(poi);
      scheduleLabelUpdate();
    };

    const focusPoi = (poi: Poi, animate = true) => {
      const marker = markerById.get(poi.id);
      if (!marker) return;
      const target = [-poi.z, poi.x] as L.LatLngExpression;
      const zoom = Math.max(map.getZoom(), -1);
      if (animate && !reduceMotion) map.flyTo(target, zoom, { duration: 0.8 });
      else map.setView(target, zoom);
      marker.openPopup();
      setActive(poi.id);
      scheduleLabelUpdate();
    };

    // ---------- Measurement tools ----------
    const measureCopy = data.measure;
    const measurePane = map.createPane('pwMeasurePane');
    measurePane.style.zIndex = '650';
    measurePane.style.pointerEvents = 'none';

    const measureLayer = L.layerGroup().addTo(map);
    const previewLayer = L.layerGroup().addTo(map);

    type MeasureMode = 'distance' | 'area';
    type MeasurePath = { kind: MeasureMode; points: L.LatLng[] };

    const measurePaths: MeasurePath[] = [];
    let measureMode: MeasureMode | null = null;
    let measureActive: MeasurePath | null = null;
    let measureCollapsed = false;
    let poisHidden = false;
    let distanceUnit = measureCopy.distanceUnits[0];
    let areaUnit = measureCopy.areaUnits[0];
    const measureBreakpoint = window.matchMedia('(max-width: 50rem)');

    const studsUnit =
      measureCopy.distanceUnits.find((unit) => unit.id === 'studs') ?? measureCopy.distanceUnits[0];
    const metersUnit =
      measureCopy.distanceUnits.find((unit) => unit.id === 'meters') ?? measureCopy.distanceUnits[0];
    const feetUnit =
      measureCopy.distanceUnits.find((unit) => unit.id === 'feet') ?? measureCopy.distanceUnits[0];

    const numberLocale = document.documentElement.lang === 'ms' ? 'ms-MY' : 'en-MY';
    const formatNumber = (value: number, decimals: number) =>
      value.toLocaleString(numberLocale, {
        minimumFractionDigits: decimals,
        maximumFractionDigits: decimals,
      });
    const formatValue = (value: number, unit: Unit) =>
      `${formatNumber(value * unit.factor, unit.decimals)} ${unit.short}`;
    const pointLabel = (count: number) =>
      `${count} ${count === 1 ? measureCopy.point : measureCopy.points}`;
    const measurementLabel = (count: number) =>
      `${count} ${count === 1 ? measureCopy.measurement : measureCopy.measurements}`;

    const distanceStuds = (a: L.LatLng, b: L.LatLng) => Math.hypot(b.lng - a.lng, b.lat - a.lat);
    const pathLength = (points: L.LatLng[]) =>
      points.reduce(
        (total, point, index) => (index ? total + distanceStuds(points[index - 1], point) : 0),
        0
      );
    const polygonPerimeter = (points: L.LatLng[]) =>
      points.length >= 2 ? pathLength([...points, points[0]]) : 0;
    const polygonArea = (points: L.LatLng[]) => {
      if (points.length < 3) return 0;
      let area = 0;
      for (let index = 0; index < points.length; index += 1) {
        const a = points[index];
        const b = points[(index + 1) % points.length];
        area += a.lng * b.lat - b.lng * a.lat;
      }
      return Math.abs(area) / 2;
    };
    const polygonCentroid = (points: L.LatLng[]) => {
      if (!points.length) return null;
      let area = 0;
      let x = 0;
      let y = 0;
      for (let index = 0; index < points.length; index += 1) {
        const a = points[index];
        const b = points[(index + 1) % points.length];
        const factor = a.lng * b.lat - b.lng * a.lat;
        area += factor;
        x += (a.lng + b.lng) * factor;
        y += (a.lat + b.lat) * factor;
      }
      area /= 2;
      if (Math.abs(area) < 1e-6) {
        const sum = points.reduce(
          (acc, point) => ({ x: acc.x + point.lng, y: acc.y + point.lat }),
          { x: 0, y: 0 }
        );
        return L.latLng(sum.y / points.length, sum.x / points.length);
      }
      return L.latLng(y / (6 * area), x / (6 * area));
    };

    const measureUnit = (mode: MeasureMode) => (mode === 'area' ? areaUnit : distanceUnit);
    const measureUnits = (mode: MeasureMode) =>
      mode === 'area' ? measureCopy.areaUnits : measureCopy.distanceUnits;

    const makeMeasureLabel = (latlng: L.LatLng, text: string, extra = '') =>
      L.marker(latlng, {
        pane: 'pwMeasurePane',
        interactive: false,
        keyboard: false,
        icon: L.divIcon({
          className: 'pw-measure-label-wrap',
          html: `<span class="pw-measure-label ${extra}">${esc(text)}</span>`,
          iconSize: [0, 0],
          iconAnchor: [0, 0],
        }),
      });

    const addVertex = (point: L.LatLng) =>
      L.circleMarker(point, {
        pane: 'pwMeasurePane',
        radius: 4,
        color: '#10203a',
        weight: 2,
        fillColor: '#ffffff',
        fillOpacity: 1,
        interactive: false,
      });

    const drawPath = (path: MeasurePath) => {
      const { points, kind } = path;
      if (!points.length) return;

      const labels: L.Layer[] = [];

      if (kind === 'distance') {
        if (points.length >= 2) {
          measureLayer.addLayer(
            L.polyline(points, {
              pane: 'pwMeasurePane',
              color: '#10203a',
              weight: 7,
              opacity: 0.42,
              interactive: false,
            })
          );
          measureLayer.addLayer(
            L.polyline(points, {
              pane: 'pwMeasurePane',
              color: '#ffd24a',
              weight: 4,
              opacity: 0.95,
              lineCap: 'round',
              lineJoin: 'round',
              interactive: false,
            })
          );

          if (points.length > 2) {
            for (let index = 1; index < points.length; index += 1) {
              const a = points[index - 1];
              const b = points[index];
              const midpoint = L.latLng((a.lat + b.lat) / 2, (a.lng + b.lng) / 2);
              labels.push(
                makeMeasureLabel(midpoint, formatValue(distanceStuds(a, b), distanceUnit))
              );
            }
          }

          const total = pathLength(points);
          labels.push(
            makeMeasureLabel(
              points[points.length - 1],
              `${measureCopy.total}: ${formatValue(total, distanceUnit)}`,
              'is-total'
            )
          );
        }
      } else if (points.length >= 3) {
        measureLayer.addLayer(
          L.polygon(points, {
            pane: 'pwMeasurePane',
            color: '#ffd24a',
            weight: 3,
            opacity: 0.95,
            fillColor: '#ffd24a',
            fillOpacity: 0.18,
            interactive: false,
          })
        );
        const center = polygonCentroid(points);
        if (center) {
          labels.push(
            makeMeasureLabel(
              center,
              `${measureCopy.areaLabel}: ${formatValue(polygonArea(points), areaUnit)}`,
              'is-area'
            )
          );
        }
      } else if (points.length >= 2) {
        measureLayer.addLayer(
          L.polyline(points, {
            pane: 'pwMeasurePane',
            color: '#ffd24a',
            weight: 3,
            opacity: 0.95,
            interactive: false,
          })
        );
      }

      for (const point of points) measureLayer.addLayer(addVertex(point));
      for (const label of labels) measureLayer.addLayer(label);
    };

    const drawMeasurements = () => {
      measureLayer.clearLayers();
      for (const path of measurePaths) drawPath(path);
      if (measureActive) drawPath(measureActive);
      updateMeasurePanel();
    };

    let previewFrame = 0;
    let previewPoint: L.LatLng | null = null;

    const clearPreview = () => {
      previewPoint = null;
      previewLayer.clearLayers();
    };

    const drawPreview = (cursor: L.LatLng) => {
      previewLayer.clearLayers();
      if (!measureActive || !measureActive.points.length) return;

      const points = measureActive.points;
      const last = points[points.length - 1];

      if (measureActive.kind === 'distance') {
        previewLayer.addLayer(
          L.polyline([last, cursor], {
            pane: 'pwMeasurePane',
            color: '#ffd24a',
            weight: 3,
            opacity: 0.78,
            dashArray: '6 5',
            interactive: false,
          })
        );
        const midpoint = L.latLng((last.lat + cursor.lat) / 2, (last.lng + cursor.lng) / 2);
        previewLayer.addLayer(
          makeMeasureLabel(midpoint, formatValue(distanceStuds(last, cursor), distanceUnit), 'is-preview')
        );
      } else {
        const previewPoints = [...points, cursor];
        if (previewPoints.length >= 3) {
          previewLayer.addLayer(
            L.polygon(previewPoints, {
              pane: 'pwMeasurePane',
              color: '#ffd24a',
              weight: 2,
              opacity: 0.72,
              dashArray: '6 5',
              fillColor: '#ffd24a',
              fillOpacity: 0.1,
              interactive: false,
            })
          );
          const center = polygonCentroid(previewPoints);
          if (center) {
            previewLayer.addLayer(
              makeMeasureLabel(
                center,
                `${measureCopy.areaLabel}: ${formatValue(polygonArea(previewPoints), areaUnit)}`,
                'is-preview'
              )
            );
          }
        } else {
          previewLayer.addLayer(
            L.polyline(previewPoints, {
              pane: 'pwMeasurePane',
              color: '#ffd24a',
              weight: 2,
              opacity: 0.72,
              dashArray: '6 5',
              interactive: false,
            })
          );
        }
      }
    };

    const schedulePreview = (point: L.LatLng) => {
      previewPoint = point;
      if (previewFrame) return;
      previewFrame = requestAnimationFrame(() => {
        previewFrame = 0;
        if (previewPoint) drawPreview(previewPoint);
      });
    };

    const populateUnitSelect = () => {
      if (!measureUnitsSelect || !measureMode) return;
      const units = measureUnits(measureMode);
      if (measureUnitsSelect.dataset.mode !== measureMode) {
        measureUnitsSelect.innerHTML = units
          .map((unit) => `<option value="${unit.id}">${esc(unit.label)}</option>`)
          .join('');
        measureUnitsSelect.dataset.mode = measureMode;
      }
      measureUnitsSelect.value = measureUnit(measureMode).id;
    };

    const setMeasureCollapsed = (collapsed: boolean) => {
      measureCollapsed = collapsed;
      measurePanel?.classList.toggle('is-collapsed', collapsed);
      if (measureCollapse) {
        measureCollapse.setAttribute('aria-expanded', String(!collapsed));
        measureCollapse.setAttribute(
          'aria-label',
          collapsed ? measureCopy.expand : measureCopy.collapse
        );
        measureCollapse.setAttribute(
          'title',
          collapsed ? measureCopy.expand : measureCopy.collapse
        );
      }
    };

    const setPoisHidden = (hidden: boolean) => {
      poisHidden = hidden;
      root?.classList.toggle('is-pois-hidden', hidden);
      if (poisToggle) {
        poisToggle.setAttribute('aria-pressed', String(hidden));
        poisToggle.setAttribute('aria-label', hidden ? measureCopy.showPois : measureCopy.hidePois);
        poisToggle.setAttribute('title', hidden ? measureCopy.showPois : measureCopy.hidePois);
      }
      if (hidden) {
        map.closePopup();
        setActive(null);
        setUrl(null);
      } else {
        measureLabels();
        updateLabels();
      }
    };

    const updateMeasurePanel = () => {
      if (!measurePanel || !measureMode) return;
      if (measureTitle) {
        measureTitle.textContent =
          measureMode === 'distance' ? measureCopy.distance : measureCopy.area;
      }
      populateUnitSelect();

      const unit = measureUnit(measureMode);
      const minimum = measureMode === 'distance' ? 2 : 3;
      const activePoints = measureActive?.points ?? [];
      const completed = measurePaths.filter((path) => path.kind === measureMode);
      const completedCount = completed.length;

      let label = measureCopy.total;
      let value = '—';
      let alt = measureCopy.empty;
      let hint = measureCopy.start;

      if (activePoints.length) {
        if (measureMode === 'distance') {
          if (activePoints.length >= 2) {
            const total = pathLength(activePoints);
            const conversions: string[] = [];
            if (unit.id !== 'studs') conversions.push(formatValue(total, studsUnit));
            if (unit.id !== 'meters') conversions.push(formatValue(total, metersUnit));
            if (!conversions.length) conversions.push(formatValue(total, feetUnit));
            value = formatValue(total, unit);
            alt = conversions.join(' · ');
          } else {
            value = pointLabel(activePoints.length);
            alt = measureCopy.addPoints;
          }
          hint = measureCopy.hint;
        } else if (activePoints.length >= 3) {
          const area = polygonArea(activePoints);
          const perimeter = polygonPerimeter(activePoints);
          label = measureCopy.areaLabel;
          value = formatValue(area, unit);
          alt = `${measureCopy.perimeter}: ${formatValue(perimeter, studsUnit)} · ${formatValue(perimeter, metersUnit)}`;
          hint = measureCopy.hint;
        } else {
          value = pointLabel(activePoints.length);
          alt = measureCopy.needPoints;
          hint = measureCopy.hint;
        }
      } else if (completedCount) {
        if (measureMode === 'distance') {
          const total = completed.reduce((sum, path) => sum + pathLength(path.points), 0);
          value = formatValue(total, unit);
        } else {
          const total = completed.reduce((sum, path) => sum + polygonArea(path.points), 0);
          value = formatValue(total, unit);
        }
        label = measureCopy.completed;
        alt = measurementLabel(completedCount);
        hint = measureCopy.addPoints;
      }

      if (measureReadoutLabel) measureReadoutLabel.textContent = label;
      if (measureValue) measureValue.textContent = value;
      if (measureAlt) measureAlt.textContent = alt;
      if (measureHint) measureHint.textContent = hint;
      if (measureFinish) measureFinish.disabled = !(measureActive && activePoints.length >= minimum);
      if (measureUndo) {
        measureUndo.disabled = !(measureActive && activePoints.length > 0) && !measurePaths.length;
      }
      if (measureClear) measureClear.disabled = !measureActive && !measurePaths.length;

      for (const tool of measureToolButtons) {
        const active = tool.dataset.measureMode === measureMode;
        tool.classList.toggle('is-active', active);
        tool.setAttribute('aria-pressed', String(active));
      }
    };

    const commitActive = () => {
      if (!measureActive) return;
      const minimum = measureActive.kind === 'distance' ? 2 : 3;
      if (measureActive.points.length >= minimum) measurePaths.push(measureActive);
      measureActive = null;
      clearPreview();
    };

    const startMeasure = (mode: MeasureMode, seed?: L.LatLng) => {
      commitActive();
      if (drawMode) exitDraw();
      const wasHidden = measurePanel?.hidden ?? true;
      measureMode = mode;
      measureActive = { kind: mode, points: seed ? [seed] : [] };
      if (measurePanel) measurePanel.hidden = false;
      if (wasHidden) setMeasureCollapsed(measureBreakpoint.matches);
      root?.classList.add('is-measuring');
      map.doubleClickZoom.disable();
      map.closePopup();
      clearPreview();
      drawMeasurements();
    };

    const exitMeasure = () => {
      commitActive();
      measureMode = null;
      measureActive = null;
      clearPreview();
      if (measurePanel) measurePanel.hidden = true;
      root?.classList.remove('is-measuring');
      map.doubleClickZoom.enable();
      for (const tool of measureToolButtons) {
        tool.classList.remove('is-active');
        tool.setAttribute('aria-pressed', 'false');
      }
      drawMeasurements();
    };

    const finishMeasure = () => {
      if (!measureActive) return;
      const minimum = measureActive.kind === 'distance' ? 2 : 3;
      if (measureActive.points.length < minimum) return;
      measurePaths.push(measureActive);
      measureActive = null;
      clearPreview();
      drawMeasurements();
    };

    const undoMeasure = () => {
      if (measureActive?.points.length) measureActive.points.pop();
      else if (measurePaths.length) measurePaths.pop();
      clearPreview();
      drawMeasurements();
    };

    const clearMeasure = () => {
      measurePaths.length = 0;
      measureActive = null;
      clearPreview();
      drawMeasurements();
    };

    let lastMeasureClick: L.LatLng | null = null;
    let lastMeasureClickTime = 0;

    map.on('click', (event) => {
      if (!measureMode) return;
      const now = Date.now();
      if (lastMeasureClick && now - lastMeasureClickTime < 400) {
        const previous = map.latLngToContainerPoint(lastMeasureClick);
        const current = map.latLngToContainerPoint(event.latlng);
        if (previous.distanceTo(current) < 5) {
          lastMeasureClick = event.latlng;
          lastMeasureClickTime = now;
          return;
        }
      }
      lastMeasureClick = event.latlng;
      lastMeasureClickTime = now;
      if (!measureActive) measureActive = { kind: measureMode, points: [] };
      measureActive.points.push(event.latlng);
      clearPreview();
      drawMeasurements();
    });

    map.on('dblclick', () => {
      if (measureMode) finishMeasure();
    });

    map.on('mousemove', (event) => {
      if (!measureMode || !measureActive || !measureActive.points.length) return;
      schedulePreview(event.latlng);
    });

    map.on('mouseout', () => clearPreview());

    for (const tool of measureToolButtons) {
      tool.addEventListener('click', () => {
        const mode = tool.dataset.measureMode as MeasureMode | undefined;
        if (!mode) return;
        if (measureMode === mode && measurePanel && !measurePanel.hidden) {
          exitMeasure();
          return;
        }
        startMeasure(mode);
        setToolsOpen(false);
      });
    }

    measureClose?.addEventListener('click', exitMeasure);
    measureCollapse?.addEventListener('click', () => setMeasureCollapsed(!measureCollapsed));
    measureBreakpoint.addEventListener('change', (event) => {
      if (measureMode) setMeasureCollapsed(event.matches);
    });
    poisToggle?.addEventListener('click', () => {
      setPoisHidden(!poisHidden);
      setToolsOpen(false);
    });
    measureFinish?.addEventListener('click', finishMeasure);
    measureUndo?.addEventListener('click', undoMeasure);
    measureClear?.addEventListener('click', clearMeasure);
    measureUnitsSelect?.addEventListener('change', () => {
      if (!measureMode) return;
      const units = measureUnits(measureMode);
      const unit = units.find((item) => item.id === measureUnitsSelect.value) ?? units[0];
      if (measureMode === 'area') areaUnit = unit;
      else distanceUnit = unit;
      drawMeasurements();
      if (previewPoint) drawPreview(previewPoint);
    });

    // ---------- Drawing tools ----------
    const drawCopy = data.draw;
    const drawPane = map.createPane('pwDrawPane');
    drawPane.style.zIndex = '460';
    drawPane.style.pointerEvents = 'none';

    const drawLayer = L.layerGroup().addTo(map);
    const drawPreviewLayer = L.layerGroup().addTo(map);

    type DrawMode = 'free' | 'line';
    type Drawing = {
      id: number;
      mode: DrawMode;
      color: string;
      width: number;
      worldWidth: number;
      points: L.LatLng[];
    };

    const drawings: Drawing[] = [];
    let drawMode: DrawMode | null = null;
    let activeDrawing: Drawing | null = null;
    let activePolyline: L.Polyline | null = null;
    let drawColor = '#ffd24a';
    let drawWidth = 6;
    let drawSequence = 0;
    let strokeActive = false;
    let strokePointerId: number | null = null;

    const screenWidthToWorld = (pixels: number) => {
      const start = map.containerPointToLatLng([0, 0]);
      const end = map.containerPointToLatLng([pixels, 0]);
      return Math.abs(end.lng - start.lng);
    };

    const makeDrawing = (mode: DrawMode, points: L.LatLng[] = []): Drawing => ({
      id: ++drawSequence,
      mode,
      color: drawColor,
      width: drawWidth,
      worldWidth: screenWidthToWorld(drawWidth),
      points,
    });

    const drawingOptions = (drawing: Drawing): L.PolylineOptions => ({
      pane: 'pwDrawPane',
      color: drawing.color,
      weight: drawing.width,
      opacity: 1,
      lineCap: 'round',
      lineJoin: 'round',
      interactive: false,
      className: 'pw-drawing',
    });

    const addDrawingShape = (drawing: Drawing, group: L.LayerGroup) => {
      if (!drawing.points.length) return null;
      if (drawing.points.length === 1) {
        group.addLayer(
          L.circleMarker(drawing.points[0], {
            pane: 'pwDrawPane',
            radius: Math.max(1.5, drawing.width / 2),
            stroke: false,
            fill: true,
            fillColor: drawing.color,
            fillOpacity: 1,
            interactive: false,
            className: 'pw-drawing pw-drawing-dot',
          })
        );
        return null;
      }
      return L.polyline(drawing.points, drawingOptions(drawing)).addTo(group);
    };

    const updateDrawPanel = () => {
      if (drawTitle) drawTitle.textContent = drawMode === 'line' ? drawCopy.line : drawCopy.free;
      if (drawHint) drawHint.textContent = drawMode === 'line' ? drawCopy.hintLine : drawCopy.hintFree;
      if (drawFinish) drawFinish.disabled = drawMode === 'line' && (activeDrawing?.points.length ?? 0) < 2;
      if (drawUndo) drawUndo.disabled = !(activeDrawing?.points.length) && !drawings.length;
      if (drawClear) drawClear.disabled = !drawings.length && !(activeDrawing?.points.length);

      for (const tool of drawToolButtons) {
        const active = tool.dataset.drawMode === drawMode;
        tool.classList.toggle('is-active', active);
        tool.setAttribute('aria-pressed', String(active));
      }
      for (const button of drawColourButtons) {
        const active = button.dataset.drawColour === drawColor;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      }
      for (const button of drawWidthButtons) {
        const active = Number(button.dataset.drawWidth) === drawWidth;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      }

      root?.classList.toggle('is-drawing', Boolean(drawMode));
      root?.classList.toggle('is-draw-free', drawMode === 'free');
      root?.classList.toggle('is-draw-line', drawMode === 'line');
    };

    const renderDrawings = () => {
      drawLayer.clearLayers();
      activePolyline = null;

      for (const drawing of drawings) addDrawingShape(drawing, drawLayer);

      if (activeDrawing && activeDrawing.points.length) {
        activePolyline = addDrawingShape(activeDrawing, drawLayer);
        if (activeDrawing.mode === 'line') {
          for (const point of activeDrawing.points) {
            drawLayer.addLayer(
              L.circleMarker(point, {
                pane: 'pwDrawPane',
                radius: 3.5,
                color: '#10203a',
                weight: 2,
                fillColor: '#ffffff',
                fillOpacity: 1,
                interactive: false,
                className: 'pw-drawing-vertex',
              })
            );
          }
        }
      }

      updateDrawPanel();
    };

    let drawPreviewFrame = 0;
    let drawPreviewPoint: L.LatLng | null = null;

    const clearDrawPreview = () => {
      drawPreviewPoint = null;
      if (drawPreviewFrame) {
        cancelAnimationFrame(drawPreviewFrame);
        drawPreviewFrame = 0;
      }
      drawPreviewLayer.clearLayers();
    };

    const renderDrawPreview = (cursor: L.LatLng) => {
      drawPreviewLayer.clearLayers();
      if (!activeDrawing || activeDrawing.mode !== 'line' || !activeDrawing.points.length) return;
      drawPreviewLayer.addLayer(
        L.polyline([...activeDrawing.points, cursor], {
          pane: 'pwDrawPane',
          color: activeDrawing.color,
          weight: activeDrawing.width,
          opacity: 0.72,
          dashArray: `${Math.max(4, activeDrawing.width)} ${Math.max(3, activeDrawing.width * 0.8)}`,
          lineCap: 'round',
          lineJoin: 'round',
          interactive: false,
          className: 'pw-drawing-preview',
        })
      );
    };

    const scheduleDrawPreview = (cursor: L.LatLng) => {
      drawPreviewPoint = cursor;
      if (drawPreviewFrame) return;
      drawPreviewFrame = requestAnimationFrame(() => {
        drawPreviewFrame = 0;
        if (drawPreviewPoint) renderDrawPreview(drawPreviewPoint);
      });
    };

    const commitActiveDrawing = () => {
      if (!activeDrawing) return false;
      const minimum = activeDrawing.mode === 'line' ? 2 : 1;
      const committed = activeDrawing.points.length >= minimum;
      if (committed) drawings.push(activeDrawing);
      activeDrawing = null;
      clearDrawPreview();
      return committed;
    };

    const closeActiveLine = () => {
      if (!activeDrawing || activeDrawing.mode !== 'line' || activeDrawing.points.length < 2) {
        return false;
      }
      drawings.push(activeDrawing);
      activeDrawing = makeDrawing('line');
      clearDrawPreview();
      renderDrawings();
      return true;
    };

    const startDraw = (mode: DrawMode) => {
      if (drawMode === mode) {
        exitDraw();
        return;
      }
      exitMeasure();
      commitActiveDrawing();
      drawMode = mode;
      activeDrawing = mode === 'line' ? makeDrawing('line') : null;
      if (drawPanel) drawPanel.hidden = false;
      map.doubleClickZoom.disable();
      if (mode === 'free') map.dragging.disable();
      else map.dragging.enable();
      map.closePopup();
      clearDrawPreview();
      renderDrawings();
    };

    const exitDraw = () => {
      commitActiveDrawing();
      drawMode = null;
      activeDrawing = null;
      clearDrawPreview();
      if (drawPanel) drawPanel.hidden = true;
      map.dragging.enable();
      map.doubleClickZoom.enable();
      renderDrawings();
    };

    const undoDraw = () => {
      if (activeDrawing?.points.length) activeDrawing.points.pop();
      else if (drawings.length) drawings.pop();
      clearDrawPreview();
      renderDrawings();
    };

    const clearDraw = () => {
      drawings.length = 0;
      if (activeDrawing) activeDrawing.points = [];
      clearDrawPreview();
      renderDrawings();
    };

    const drawContainer = map.getContainer();

    const beginStroke = (event: PointerEvent) => {
      if (drawMode !== 'free' || !event.isPrimary) return;
      if (event.pointerType === 'mouse' && event.button !== 0) return;
      event.preventDefault();
      event.stopPropagation();

      activeDrawing = makeDrawing('free', [map.mouseEventToLatLng(event)]);
      strokeActive = true;
      strokePointerId = event.pointerId;
      try {
        drawContainer.setPointerCapture(event.pointerId);
      } catch {
        /* Pointer capture can fail if the pointer was already released. */
      }
      root?.classList.add('is-stroking');
      renderDrawings();
    };

    const extendStroke = (event: PointerEvent) => {
      if (!strokeActive || drawMode !== 'free' || !activeDrawing) return;
      event.preventDefault();
      const point = map.mouseEventToLatLng(event);
      const last = activeDrawing.points[activeDrawing.points.length - 1];
      if (!last) return;
      const lastPoint = map.latLngToContainerPoint(last);
      const nextPoint = map.latLngToContainerPoint(point);
      if (lastPoint.distanceTo(nextPoint) < 2) return;
      activeDrawing.points.push(point);
      if (activePolyline) activePolyline.setLatLngs(activeDrawing.points);
      else renderDrawings();
    };

    const endStroke = () => {
      if (!strokeActive) return;
      strokeActive = false;
      if (strokePointerId !== null) {
        try {
          drawContainer.releasePointerCapture(strokePointerId);
        } catch {
          /* The pointer may already have been released by the browser. */
        }
        strokePointerId = null;
      }
      root?.classList.remove('is-stroking');
      if (activeDrawing) {
        if (activeDrawing.points.length) drawings.push(activeDrawing);
        activeDrawing = null;
      }
      renderDrawings();
    };

    drawContainer.addEventListener('pointerdown', beginStroke, { passive: false });
    drawContainer.addEventListener('pointermove', extendStroke, { passive: false });
    drawContainer.addEventListener('pointerup', endStroke);
    drawContainer.addEventListener('pointercancel', endStroke);
    drawContainer.addEventListener('lostpointercapture', endStroke);

    let lastLineClick: L.LatLng | null = null;
    let lastLineClickTime = 0;

    map.on('click', (event) => {
      if (drawMode !== 'line') return;
      const now = Date.now();
      if (lastLineClick && now - lastLineClickTime < 400) {
        const previous = map.latLngToContainerPoint(lastLineClick);
        const current = map.latLngToContainerPoint(event.latlng);
        if (previous.distanceTo(current) < 5) {
          lastLineClick = event.latlng;
          lastLineClickTime = now;
          return;
        }
      }
      lastLineClick = event.latlng;
      lastLineClickTime = now;
      if (!activeDrawing) {
        activeDrawing = makeDrawing('line');
      }
      if (!activeDrawing.points.length) {
        activeDrawing.worldWidth = screenWidthToWorld(activeDrawing.width);
      }
      activeDrawing.points.push(event.latlng);
      clearDrawPreview();
      renderDrawings();
    });

    map.on('dblclick', () => {
      if (drawMode === 'line') closeActiveLine();
    });

    map.on('mousemove', (event) => {
      if (drawMode !== 'line' || !activeDrawing || !activeDrawing.points.length) return;
      scheduleDrawPreview(event.latlng);
    });

    map.on('mouseout', () => {
      if (drawMode === 'line') clearDrawPreview();
    });

    for (const tool of drawToolButtons) {
      tool.addEventListener('click', () => {
        const mode = tool.dataset.drawMode as DrawMode | undefined;
        if (!mode) return;
        const wasActive = drawMode === mode;
        startDraw(mode);
        if (!wasActive) setToolsOpen(false);
      });
    }

    for (const button of drawColourButtons) {
      button.addEventListener('click', () => {
        const colour = button.dataset.drawColour;
        if (!colour) return;
        drawColor = colour;
        if (activeDrawing) activeDrawing.color = colour;
        renderDrawings();
      });
    }

    for (const button of drawWidthButtons) {
      button.addEventListener('click', () => {
        const width = Number(button.dataset.drawWidth);
        if (!Number.isFinite(width) || width <= 0) return;
        drawWidth = width;
        if (activeDrawing) {
          activeDrawing.width = width;
          activeDrawing.worldWidth = screenWidthToWorld(width);
        }
        renderDrawings();
      });
    }

    drawClose?.addEventListener('click', exitDraw);
    drawFinish?.addEventListener('click', () => {
      if (drawMode === 'line') closeActiveLine();
      else exitDraw();
    });
    drawUndo?.addEventListener('click', undoDraw);
    drawClear?.addEventListener('click', clearDraw);

    document.addEventListener('keydown', (event) => {
      if (!drawMode || downloadDialog?.open) return;
      if (event.key === 'Escape') {
        if (activeDrawing?.points.length) {
          activeDrawing = null;
          clearDrawPreview();
          renderDrawings();
        } else {
          exitDraw();
        }
      }
      if (event.key === 'Enter') {
        event.preventDefault();
        if (drawMode === 'line') closeActiveLine();
        else exitDraw();
      }
    });

    renderDrawings();

    document.addEventListener('keydown', (event) => {
      if (!measureMode || downloadDialog?.open) return;
      if (event.key === 'Escape') {
        if (measureActive?.points.length) {
          measureActive = null;
          clearPreview();
          drawMeasurements();
        } else {
          exitMeasure();
        }
      }
      if (event.key === 'Enter') finishMeasure();
    });

    // ---------- Download map ----------
    const downloadCopy = data.download;
    type PlacesMode = 'all' | 'none' | 'selected';
    let placesMode: PlacesMode = 'all';
    const selectedPlaceIds = new Set<string>(data.pois.map((poi) => poi.id));
    let downloadListBuilt = false;
    let downloadQuery = '';

    const placeIconMarkup = (poi: Poi) => {
      if (poi.iconFile === 'generic') {
        const pinColor = esc(poi.poiColor || '#78909C');
        return `<svg class="pw-download__place-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5a7 7 0 0 0-7 7c0 4.6 7 12 7 12s7-7.4 7-12a7 7 0 0 0-7-7Z" fill="${pinColor}" stroke="#16233a" stroke-width="1.6"/><circle cx="12" cy="9.5" r="2.6" fill="#fff"/></svg>`;
      }
      return `<img class="pw-download__place-icon" src="/MapIcons/${poi.iconFile}" alt="" width="22" height="22" loading="lazy" />`;
    };

    const buildDownloadList = () => {
      if (downloadListBuilt || !downloadList) return;
      downloadList.innerHTML = data.pois
        .map((poi) => {
          const searchText = `${poi.label} ${poi.catLabel}`.toLowerCase();
          return `
            <label class="pw-download__place" data-download-place="${poi.id}" data-download-search-text="${esc(searchText)}">
              <input type="checkbox" data-download-id="${poi.id}"${selectedPlaceIds.has(poi.id) ? ' checked' : ''} />
              ${placeIconMarkup(poi)}
              <span class="pw-download__place-text">
                <strong>${esc(poi.label)}</strong>
                <small>${esc(poi.catLabel)}</small>
              </span>
            </label>
          `;
        })
        .join('');
      downloadListBuilt = true;
    };

    const updateDownloadCount = () => {
      if (!downloadCount) return;
      const label =
        selectedPlaceIds.size === 1 ? downloadCopy.selectedCountOne : downloadCopy.selectedCount;
      downloadCount.textContent = `${selectedPlaceIds.size} ${label}`;
    };

    const filterDownloadList = () => {
      if (!downloadList) return;
      const needle = downloadQuery.trim().toLowerCase();
      let shown = 0;
      for (const item of downloadList.querySelectorAll<HTMLElement>('[data-download-place]')) {
        const matches = !needle || (item.dataset.downloadSearchText ?? '').includes(needle);
        item.hidden = !matches;
        if (matches) shown += 1;
      }
      if (downloadEmpty) downloadEmpty.hidden = shown > 0;
    };

    const setPlacesMode = (mode: PlacesMode) => {
      placesMode = mode;
      for (const input of downloadModeInputs) input.checked = input.value === mode;
      if (downloadPicker) downloadPicker.hidden = mode !== 'selected';
      updateDownloadCount();
    };

    const openDownload = () => {
      if (!downloadDialog) return;
      if (drawMode) exitDraw();
      if (downloadError) downloadError.hidden = true;
      buildDownloadList();
      filterDownloadList();
      setPlacesMode(placesMode);
      if (!downloadDialog.open) downloadDialog.showModal();
      if (placesMode === 'selected') {
        requestAnimationFrame(() => downloadSearch?.focus());
      }
    };

    downloadList?.addEventListener('change', (event) => {
      const input = (event.target as Element).closest<HTMLInputElement>('input[data-download-id]');
      if (!input) return;
      const id = input.dataset.downloadId;
      if (!id) return;
      if (input.checked) selectedPlaceIds.add(id);
      else selectedPlaceIds.delete(id);
      updateDownloadCount();
    });

    downloadSearch?.addEventListener('input', () => {
      downloadQuery = downloadSearch.value;
      filterDownloadList();
    });

    for (const input of downloadModeInputs) {
      input.addEventListener('change', () => {
        if (!input.checked) return;
        const mode = input.value as PlacesMode;
        setPlacesMode(mode);
        if (mode === 'selected') {
          requestAnimationFrame(() => downloadSearch?.focus());
        }
      });
    }

    downloadSelectAll?.addEventListener('click', () => {
      if (!downloadList) return;
      for (const item of downloadList.querySelectorAll<HTMLElement>('[data-download-place]')) {
        if (item.hidden) continue;
        const input = item.querySelector<HTMLInputElement>('input[data-download-id]');
        if (!input?.dataset.downloadId) continue;
        input.checked = true;
        selectedPlaceIds.add(input.dataset.downloadId);
      }
      updateDownloadCount();
    });

    downloadClear?.addEventListener('click', () => {
      selectedPlaceIds.clear();
      for (const input of downloadList?.querySelectorAll<HTMLInputElement>('input[data-download-id]') ?? []) {
        input.checked = false;
      }
      updateDownloadCount();
    });

    for (const button of downloadDialog?.querySelectorAll<HTMLButtonElement>('[data-download-close]') ?? []) {
      button.addEventListener('click', () => downloadDialog?.close());
    }

    downloadDialog?.addEventListener('submit', (event) => {
      event.preventDefault();
    });

    downloadDialog?.addEventListener('click', (event) => {
      if (event.target === downloadDialog) downloadDialog.close();
    });

    downloadDialog?.addEventListener('close', () => {
      if (downloadError) downloadError.hidden = true;
    });

    const MAP_EXPORT_WIDTH = 2400;
    const MAP_EXPORT_HEIGHT = 1245;
    const EXPORT_REFERENCE_WIDTH = 1200;

    const imageCache = new Map<string, Promise<HTMLImageElement>>();
    const loadImage = (src: string) => {
      const cached = imageCache.get(src);
      if (cached) return cached;
      const promise = new Promise<HTMLImageElement>((resolve, reject) => {
        const image = new Image();
        image.decoding = 'async';
        image.onload = () => resolve(image);
        image.onerror = () => reject(new Error(`Could not load ${src}`));
        image.src = src;
      });
      imageCache.set(src, promise);
      return promise;
    };

    const drawExportPin = (
      ctx: CanvasRenderingContext2D,
      x: number,
      y: number,
      size: number,
      color: string
    ) => {
      const scale = size / 24;
      ctx.save();
      ctx.translate(x - 12 * scale, y - 12 * scale);
      ctx.scale(scale, scale);
      ctx.beginPath();
      ctx.moveTo(12, 2.5);
      ctx.bezierCurveTo(8.13, 2.5, 5, 5.63, 5, 9.5);
      ctx.bezierCurveTo(5, 14.1, 12, 21.5, 12, 21.5);
      ctx.bezierCurveTo(12, 21.5, 19, 14.1, 19, 9.5);
      ctx.bezierCurveTo(19, 5.63, 15.87, 2.5, 12, 2.5);
      ctx.closePath();
      ctx.fillStyle = color || '#78909C';
      ctx.strokeStyle = '#16233a';
      ctx.lineWidth = 2;
      ctx.fill();
      ctx.stroke();
      ctx.beginPath();
      ctx.arc(12, 9.5, 2.6, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      ctx.restore();
    };

    const drawExportPlaces = async (
      ctx: CanvasRenderingContext2D,
      chosen: Poi[],
      width: number,
      height: number,
      scale: number,
      toX: (x: number) => number,
      toY: (z: number) => number
    ) => {
      const iconSize = 30 * scale;
      const iconRadius = iconSize / 2;
      const labelHeight = 18 * scale;
      const font = `700 ${12 * scale}px "Public Sans", system-ui, sans-serif`;
      const padX = 6 * scale;
      const padY = 3 * scale;
      const gap = 5 * scale;
      const images = new Map<string, HTMLImageElement | null>();

      await Promise.all(
        [...new Set(chosen.filter((poi) => poi.iconFile !== 'generic').map((poi) => poi.iconFile))].map(
          async (file) => {
            try {
              images.set(file, await loadImage(`/MapIcons/${file}`));
            } catch {
              images.set(file, null);
            }
          }
        )
      );

      const points = chosen.map((poi) => ({
        poi,
        x: toX(poi.x),
        y: toY(poi.z),
      }));

      for (const point of points) {
        if (point.poi.iconFile === 'generic') {
          drawExportPin(ctx, point.x, point.y, iconSize, point.poi.poiColor);
          continue;
        }
        const image = images.get(point.poi.iconFile);
        if (image) {
          const ratio = Math.min(iconSize / image.naturalWidth, iconSize / image.naturalHeight);
          const imageWidth = image.naturalWidth * ratio;
          const imageHeight = image.naturalHeight * ratio;
          ctx.drawImage(
            image,
            point.x - imageWidth / 2,
            point.y - imageHeight / 2,
            imageWidth,
            imageHeight
          );
        } else {
          drawExportPin(ctx, point.x, point.y, iconSize, point.poi.poiColor);
        }
      }

      ctx.save();
      ctx.font = font;
      ctx.textBaseline = 'middle';
      ctx.lineJoin = 'round';
      ctx.lineWidth = Math.max(2, 2.2 * scale);

      type Rect = { left: number; top: number; right: number; bottom: number };
      const overlaps = (a: Rect, b: Rect) =>
        a.left < b.right && a.right > b.left && a.top < b.bottom && a.bottom > b.top;
      const rectFor = (
        side: 'right' | 'left' | 'top' | 'bottom',
        x: number,
        y: number,
        rectWidth: number,
        rectHeight: number,
        distance: number
      ): Rect => {
        if (side === 'right') {
          const left = x + iconRadius + distance;
          return { left, top: y - rectHeight / 2, right: left + rectWidth, bottom: y + rectHeight / 2 };
        }
        if (side === 'left') {
          const right = x - iconRadius - distance;
          return { left: right - rectWidth, top: y - rectHeight / 2, right, bottom: y + rectHeight / 2 };
        }
        if (side === 'bottom') {
          const top = y + iconRadius + distance;
          return { left: x - rectWidth / 2, top, right: x + rectWidth / 2, bottom: top + rectHeight };
        }
        const bottom = y - iconRadius - distance;
        return { left: x - rectWidth / 2, top: bottom - rectHeight, right: x + rectWidth / 2, bottom };
      };

      const placed: Rect[] = [];
      const iconRects = points.map((point) => ({
        left: point.x - iconRadius,
        top: point.y - iconRadius,
        right: point.x + iconRadius,
        bottom: point.y + iconRadius,
      }));
      const sides = ['right', 'left', 'bottom', 'top'] as const;
      const distances = [gap, gap * 2.1, gap * 3.4];
      const ordered = [...points].sort(
        (a, b) =>
          (a.x - width / 2) ** 2 +
          (a.y - height / 2) ** 2 -
          ((b.x - width / 2) ** 2 + (b.y - height / 2) ** 2)
      );

      for (const point of ordered) {
        const text = point.poi.label;
        const rectWidth = ctx.measureText(text).width + padX * 2;
        const rectHeight = labelHeight + padY * 2;
        let rect: Rect | null = null;
        let side: (typeof sides)[number] = 'right';

        for (const distance of distances) {
          for (const candidate of sides) {
            const candidateRect = rectFor(
              candidate,
              point.x,
              point.y,
              rectWidth,
              rectHeight,
              distance
            );
            if (
              candidateRect.left < 2 ||
              candidateRect.top < 2 ||
              candidateRect.right > width - 2 ||
              candidateRect.bottom > height - 2
            ) {
              continue;
            }
            if (iconRects.some((icon) => overlaps(candidateRect, icon))) continue;
            if (placed.some((other) => overlaps(candidateRect, other))) continue;
            rect = candidateRect;
            side = candidate;
            break;
          }
          if (rect) break;
        }

        // If there is no clear space left, leave the icon unlabelled rather
        // than printing text on top of another place.
        if (!rect) continue;

        placed.push(rect);
        let textX = point.x;
        let textAlign: CanvasTextAlign = 'left';
        if (side === 'right') {
          textX = rect.left + padX;
          textAlign = 'left';
        } else if (side === 'left') {
          textX = rect.right - padX;
          textAlign = 'right';
        } else {
          textX = point.x;
          textAlign = 'center';
        }
        const textY = (rect.top + rect.bottom) / 2;
        ctx.textAlign = textAlign;
        ctx.strokeStyle = 'rgba(0, 0, 0, 0.68)';
        ctx.strokeText(text, textX, textY);
        ctx.fillStyle = point.poi.textColor || '#FFFFFF';
        ctx.fillText(text, textX, textY);
      }

      ctx.restore();
    };

    const exportMapCanvas = async () => {
      if ('fonts' in document) await document.fonts.ready.catch(() => {});
      const width = MAP_EXPORT_WIDTH;
      const height = MAP_EXPORT_HEIGHT;
      const canvas = document.createElement('canvas');
      canvas.width = width;
      canvas.height = height;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Canvas is unavailable.');

      const { minX, maxX, minZ, maxZ } = data.bounds;
      const toX = (x: number) => ((x - minX) / (maxX - minX)) * width;
      const toY = (z: number) => ((z - minZ) / (maxZ - minZ)) * height;
      const scale = width / EXPORT_REFERENCE_WIDTH;
      const worldScale = width / (maxX - minX);

      ctx.fillStyle = '#a4ce8d';
      ctx.fillRect(0, 0, width, height);
      const base = await loadImage('/minimap.svg');
      ctx.drawImage(base, 0, 0, width, height);

      ctx.save();
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      for (const drawing of drawings) {
        if (!drawing.points.length) continue;
        ctx.strokeStyle = drawing.color;
        ctx.fillStyle = drawing.color;
        ctx.lineWidth = Math.max(1.5, drawing.worldWidth * worldScale);
        if (drawing.points.length === 1) {
          const point = drawing.points[0];
          ctx.beginPath();
          ctx.arc(
            toX(point.lng),
            toY(-point.lat),
            Math.max(1.5, (drawing.worldWidth * worldScale) / 2),
            0,
            Math.PI * 2
          );
          ctx.fill();
          continue;
        }
        ctx.beginPath();
        drawing.points.forEach((point, index) => {
          const x = toX(point.lng);
          const y = toY(-point.lat);
          if (index === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        });
        ctx.stroke();
      }
      ctx.restore();

      const chosen =
        placesMode === 'all'
          ? data.pois
          : placesMode === 'none'
            ? []
            : data.pois.filter((poi) => selectedPlaceIds.has(poi.id));

      if (chosen.length) {
        await drawExportPlaces(ctx, chosen, width, height, scale, toX, toY);
      }

      return canvas;
    };

    const downloadMapPng = async () => {
      const canvas = await exportMapCanvas();
      const blob = await new Promise<Blob>((resolve, reject) => {
        canvas.toBlob((result) => {
          if (result) resolve(result);
          else reject(new Error('Could not encode the map image.'));
        }, 'image/png');
      });

      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download =
        document.documentElement.lang === 'ms' ? 'peta-putrajaya.png' : 'putrajaya-map.png';
      link.rel = 'noopener';
      document.body.append(link);
      link.click();
      link.remove();
      window.setTimeout(() => URL.revokeObjectURL(url), 4000);
    };

    const runDownload = async () => {
      if (!downloadRun) return;
      const label = downloadRun.textContent ?? downloadCopy.run;
      downloadRun.disabled = true;
      downloadRun.textContent = downloadCopy.preparing;
      downloadDialog?.setAttribute('aria-busy', 'true');
      if (downloadError) downloadError.hidden = true;
      try {
        await downloadMapPng();
        downloadDialog?.close();
      } catch (error) {
        console.error(error);
        if (downloadError) {
          downloadError.textContent = downloadCopy.error;
          downloadError.hidden = false;
        }
      } finally {
        downloadRun.disabled = false;
        downloadRun.textContent = label;
        downloadDialog?.removeAttribute('aria-busy');
      }
    };

    downloadOpen?.addEventListener('click', () => {
      setToolsOpen(false);
      openDownload();
    });
    downloadRun?.addEventListener('click', runDownload);
    updateDownloadCount();

    // ---------- Fullscreen ----------
    let cssFullscreen = false;
    let fullscreenBusy = false;
    let fullscreenParent: HTMLElement | null = null;
    let fullscreenNext: Node | null = null;
    let fullscreenPlaceholder: HTMLElement | null = null;
    const isNativeFullscreen = () => document.fullscreenElement === root;

    const mountFullscreen = () => {
      if (!root || !root.parentElement || root.parentElement === document.body) return;
      fullscreenParent = root.parentElement;
      fullscreenNext = root.nextSibling;

      const placeholder = document.createElement('div');
      placeholder.className = 'pw-map__placeholder';
      placeholder.setAttribute('aria-hidden', 'true');
      placeholder.style.height = `${root.offsetHeight}px`;
      placeholder.style.margin = getComputedStyle(root).margin;
      fullscreenParent.insertBefore(placeholder, root);
      fullscreenPlaceholder = placeholder;
      document.body.append(root);
    };

    const unmountFullscreen = () => {
      if (!root || !fullscreenParent) return;
      const parent = fullscreenParent;
      const next = fullscreenNext;
      fullscreenParent = null;
      fullscreenNext = null;
      if (next && next.parentNode === parent) parent.insertBefore(root, next);
      else parent.append(root);
      fullscreenPlaceholder?.remove();
      fullscreenPlaceholder = null;
    };

    const syncFullscreen = () => {
      const active = isNativeFullscreen() || cssFullscreen;
      if (!active) {
        setToolsOpen(false);
        setFiltersOpen(false);
      }
      root?.classList.toggle('is-fullscreen', active);
      document.documentElement.classList.toggle('pw-map-fs-lock', active);

      if (fullscreenToggles.length) {
        for (const toggle of fullscreenToggles) {
          toggle.setAttribute('aria-pressed', String(active));
          const label = active
            ? (toggle.dataset.labelExit ?? '')
            : (toggle.dataset.labelEnter ?? '');
          if (label) {
            toggle.setAttribute('aria-label', label);
            toggle.setAttribute('title', label);
          }
        }
      }

      window.setTimeout(() => {
        map.invalidateSize();
        if (map.getZoom() <= map.getMinZoom() + 0.01) fitMap();
        measureLabels();
        scheduleLabelUpdate();
      }, 140);
    };

    const toggleFullscreen = async () => {
      if (fullscreenBusy) return;
      fullscreenBusy = true;
      try {
        if (isNativeFullscreen() || cssFullscreen) {
          cssFullscreen = false;
          if (isNativeFullscreen() && document.exitFullscreen) {
            try {
              await document.exitFullscreen();
            } catch {
              /* The browser may already have left fullscreen. */
            }
          }
          syncFullscreen();
          unmountFullscreen();
          return;
        }

        mountFullscreen();

        if (root && document.fullscreenEnabled && typeof root.requestFullscreen === 'function') {
          try {
            await root.requestFullscreen();
            if (isNativeFullscreen()) {
              syncFullscreen();
              return;
            }
          } catch {
            /* iOS and some embedded browsers do not expose element fullscreen. */
          }
        }

        cssFullscreen = true;
        syncFullscreen();
      } finally {
        fullscreenBusy = false;
      }
    };

    for (const toggle of fullscreenToggles) {
      toggle.addEventListener('click', () => {
        void toggleFullscreen();
      });
    }

    document.addEventListener('fullscreenchange', () => {
      const native = isNativeFullscreen();
      if (!native) cssFullscreen = false;
      syncFullscreen();
      if (!native) unmountFullscreen();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !cssFullscreen) return;
      if (downloadDialog?.open) return;
      cssFullscreen = false;
      syncFullscreen();
      unmountFullscreen();
    });

    for (const button of filterButtons) {
      button.addEventListener('click', () => {
        category = button.dataset.mapFilter ?? 'all';
        for (const other of filterButtons) {
          const active = other === button;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-pressed', String(active));
        }
        updateFilterToggle();
        setFiltersOpen(false);
        if (filterToggle && getComputedStyle(filterToggle).display !== 'none') {
          filterToggle.focus({ preventScroll: true });
        }
        render();
      });
    }

    filterToggle?.addEventListener('click', () => {
      setFiltersOpen(!root?.classList.contains('is-filters-open'));
    });

    toolsToggle?.addEventListener('click', () => {
      setToolsOpen(!root?.classList.contains('is-tools-open'));
    });

    search?.addEventListener('input', () => {
      query = search.value;
      render();
    });

    document.addEventListener('click', (event) => {
      const measureButton = (event.target as Element).closest<HTMLButtonElement>('[data-measure-poi]');
      if (measureButton) {
        const id = measureButton.dataset.measurePoi;
        const poi = id ? poiById.get(id) : null;
        if (poi) {
          map.closePopup();
          startMeasure('distance', L.latLng(-poi.z, poi.x));
        }
        return;
      }

      const button = (event.target as Element).closest<HTMLButtonElement>('[data-copy-poi]');
      if (!button) return;
      const id = button.dataset.copyPoi;
      if (!id) return;
      const url = `${window.location.origin}${window.location.pathname}?poi=${encodeURIComponent(id)}`;
      const done = () => {
        const original = button.innerHTML;
        button.textContent = data.labels.copied;
        window.setTimeout(() => {
          button.innerHTML = original;
        }, 1600);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(url).then(done).catch(done);
      } else {
        done();
      }
    });

    map.on('popupopen', () => {
      if (measureMode || drawMode) {
        map.closePopup();
        return;
      }
      root?.classList.add('is-poi-open');
    });
    map.on('popupclose', () => {
      root?.classList.remove('is-poi-open');
      setActive(null);
    });
    map.on('move zoom resize viewreset moveend zoomend', scheduleLabelUpdate);

    render();

    const initialId = new URLSearchParams(window.location.search).get('poi');
    if (initialId) {
      const poi = poiById.get(initialId);
      if (poi) {
        focusPoi(poi, false);
        setUrlForPoi(poi);
      }
    }

    if ('fonts' in document) {
      document.fonts.ready.then(() => {
        measureLabels();
        scheduleLabelUpdate();
      });
    }

    if ('ResizeObserver' in window) {
      const observer = new ResizeObserver(() => {
        const atOverview = map.getZoom() <= map.getMinZoom() + 0.01;
        map.invalidateSize();
        if (atOverview) fitMap();
        scheduleLabelUpdate();
      });
      observer.observe(canvas);
    }
  }
</script>

