---
import Default from '@astrojs/starlight/components/MobileTableOfContents.astro';
import { getCollection } from 'astro:content';
import PwIcon from './PwIcon.astro';

const locale = Astro.locals.starlightRoute?.locale ?? 'en';
const isMs = locale === 'ms';
const base = isMs ? '/ms' : '';
const allDocs = await getCollection('docs');
const isMsEntry = (id: string) => id === 'ms' || id.startsWith('ms/');

const docs = allDocs.filter(
  (entry) =>
    (isMs ? isMsEntry(entry.id) : !isMsEntry(entry.id)) &&
    entry.id !== 'index' &&
    entry.id !== 'ms' &&
    !entry.id.endsWith('404') &&
    Boolean(entry.data.category)
);

const groups = new Map<string, typeof docs>();
for (const doc of docs) {
  const category = doc.data.category as string;
  if (!groups.has(category)) groups.set(category, []);
  groups.get(category)!.push(doc);
}

const preferred = ['Start here', 'City', 'Companies'];
const nav = [...groups.entries()]
  .sort((a, b) => {
    const ia = preferred.indexOf(a[0]);
    const ib = preferred.indexOf(b[0]);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a[0].localeCompare(b[0]);
  })
  .map(([label, items]) => ({
    label,
    items: items.sort(
      (a, b) =>
        Number(Boolean(b.data.landing)) - Number(Boolean(a.data.landing)) ||
        a.data.title.localeCompare(b.data.title)
    ),
  }));
---

<Default />

<nav class="pw-wikibar" aria-label="Wiki navigation">
  <details>
    <summary>
      <span>Wiki navigation</span>
      <PwIcon name="bi-chevron-down" class="pw-wikibar__caret" />
    </summary>
    <div class="pw-wikibar__dropdown">
      {
        nav.map((group) => (
          <div class="pw-wikibar__group">
            <p class="pw-wikibar__title">{group.label}</p>
            {group.items.map((doc) => (
              <a href={`${base}/${doc.id}/`}>
                <PwIcon name="bi-journal-text" />
                {doc.data.title}
              </a>
            ))}
          </div>
        ))
      }
    </div>
  </details>
</nav>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.pw-wikibar details').forEach((details) => {
    window.addEventListener('click', (event) => {
      if (!details.contains(event.target as Node)) details.open = false;
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) details.open = false;
    });
    details.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        details.open = false;
      });
    });
  });
</script>
