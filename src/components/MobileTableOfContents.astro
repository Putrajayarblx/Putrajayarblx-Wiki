---
import { getCollection } from 'astro:content';
import PwIcon from './PwIcon.astro';

const { toc } = Astro.locals.starlightRoute;
const locale = Astro.locals.starlightRoute.locale ?? 'en';
const isMs = locale === 'ms';
const base = isMs ? '/ms' : '';

const allDocs = await getCollection('docs');
const isMsEntry = (id: string) => id === 'ms' || id.startsWith('ms/');
const docs = allDocs.filter(
  (entry) =>
    (isMs ? isMsEntry(entry.id) : !isMsEntry(entry.id)) &&
    entry.id !== 'index' &&
    entry.id !== 'ms' &&
    !entry.id.endsWith('404') &&
    Boolean(entry.data.category)
);

const groups = new Map<string, typeof docs>();
for (const doc of docs) {
  const category = doc.data.category as string;
  if (!groups.has(category)) groups.set(category, []);
  groups.get(category)!.push(doc);
}

const preferred = ['Start here', 'City', 'Companies'];
const nav = [...groups.entries()]
  .sort((a, b) => {
    const ia = preferred.indexOf(a[0]);
    const ib = preferred.indexOf(b[0]);
    return (ia === -1 ? 99 : ia) - (ib === -1 ? 99 : ib) || a[0].localeCompare(b[0]);
  })
  .map(([label, items]) => ({
    label,
    items: items.sort(
      (a, b) =>
        Number(Boolean(b.data.landing)) - Number(Boolean(a.data.landing)) ||
        a.data.title.localeCompare(b.data.title)
    ),
  }));

const tocItems = toc?.items ?? [];
---

<nav class="pw-mobilebar" aria-label="Wiki and page navigation">
  <details class="pw-mobilebar__panel" data-pw-panel>
    <summary>
      <PwIcon name="bi-journal-text" />
      <span>Navigation</span>
      <PwIcon name="bi-chevron-down" class="pw-mobilebar__caret" />
    </summary>
    <div class="pw-mobilebar__dropdown">
      {
        nav.map((group) => (
          <details class="pw-mobilebar__group" open>
            <summary class="pw-mobilebar__title">
              <span>{group.label}</span>
              <PwIcon name="bi-chevron-down" class="pw-mobilebar__caret" />
            </summary>
            <div class="pw-mobilebar__links">
              {group.items.map((doc) => (
                <a href={`${base}/${doc.id}/`}>{doc.data.title}</a>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </details>

  {
    toc && (
      <details class="pw-mobilebar__panel pw-mobilebar__panel--end" data-pw-panel>
        <summary>
          <span>On this page</span>
          <PwIcon name="bi-chevron-down" class="pw-mobilebar__caret" />
        </summary>
        <div class="pw-mobilebar__dropdown">
          <ul class="pw-mobilebar__toc">
            {tocItems.map((item) => (
              <li>
                <a href={`#${item.slug}`}>{item.text}</a>
                {item.children.length > 0 && (
                  <ul>
                    {item.children.map((child) => (
                      <li>
                        <a href={`#${child.slug}`}>{child.text}</a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </div>
      </details>
    )
  }
</nav>

<script>
  const panels = document.querySelectorAll<HTMLDetailsElement>('[data-pw-panel]');
  panels.forEach((panel) => {
    panel.addEventListener('toggle', () => {
      if (panel.open) panels.forEach((other) => other !== panel && (other.open = false));
    });
    window.addEventListener('click', (event) => {
      if (!panel.contains(event.target as Node)) panel.open = false;
    });
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && panel.open) panel.open = false;
    });
    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        panel.open = false;
      });
    });
  });
</script>
