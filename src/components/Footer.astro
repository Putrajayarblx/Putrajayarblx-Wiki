---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import Default from '@astrojs/starlight/components/Footer.astro';
import PwIcon from './PwIcon.astro';

const route = Astro.locals.starlightRoute;
const hasSidebar = route.hasSidebar;
const isMs = (route.locale ?? 'en') === 'ms';
const base = isMs ? '/ms' : '';

// Build metadata for the technical footer line.
const pkg = JSON.parse(readFileSync(join(process.cwd(), 'package.json'), 'utf8')) as {
  dependencies?: Record<string, string>;
};
const version = (name: string) =>
  pkg.dependencies?.[name]?.replace(/^[^\d]*/, '') ?? '';

const astroVersion = version('astro');
const starlightVersion = version('@astrojs/starlight');
const commit = (process.env.VERCEL_GIT_COMMIT_SHA ?? '').slice(0, 7);
const commitUrl = commit
  ? `https://github.com/Putrajayarblx/Putrajayarblx-Wiki/commit/${commit}`
  : null;

// The upload pipeline creates a WebP copy; fall back to the original upload.
const qrPng = '/uploads/WPPLinktreeQRwhiteBG.png';
const qrWebp = '/uploads/WPPLinktreeQRwhiteBG.webp';
const qrSrc = existsSync(join(process.cwd(), 'public', qrWebp)) ? qrWebp : qrPng;
const linksHref = 'https://linktr.ee/putrajaya.rblx';

// Malay headings have different slugs; keep the footer anchors stable.
const cookiesHash = isMs ? 'cookie' : 'cookies';
const disclaimerHash = isMs ? 'penafian' : 'disclaimer';

const t = isMs
  ? {
      helpful: 'Adakah halaman ini membantu?',
      yes: 'Ya',
      no: 'Tidak',
      thanksYes: 'Terima kasih — gembira ia membantu.',
      thanksNo: 'Terima kasih — maklum balas direkodkan.',
      report: 'Laporkan ralat pada halaman ini',
      minute: 'min bacaan',
      body: 'Apakah yang salah?',
      rendered: 'Halaman dijana pada masa binaan dengan',
      commit: 'sumber',
      licenseBefore: 'Teks tersedia di bawah',
      licenseLabel: 'Lesen Creative Commons Attribution-ShareAlike 4.0',
      licenseAfter:
        '; terma tambahan mungkin terpakai. Putrajaya.rblx Wiki ialah projek komuniti dan tidak bergabung dengan Roblox Corporation.',
      footerNav: 'Pengaki wiki',
      privacy: 'Dasar privasi',
      about: 'Tentang wiki',
      disclaimers: 'Penafian',
      contact: 'Hubungi',
      contributing: 'Menyumbang',
      developers: 'Pembangun',
      statistics: 'Statistik',
      cookies: 'Kenyataan cookie',
      top: 'Kembali ke atas',
      scan: 'Imbas untuk pautan komuniti',
      qrAlt: 'Kod QR untuk pautan komuniti Putrajaya.rblx',
    }
  : {
      helpful: 'Was this page helpful?',
      yes: 'Yes',
      no: 'No',
      thanksYes: 'Thanks — glad it helped.',
      thanksNo: 'Thanks — your feedback was recorded.',
      report: 'Report an error on this page',
      minute: 'min read',
      body: 'What is wrong?',
      rendered: 'Page rendered at build time with',
      commit: 'source',
      licenseBefore: 'Text is available under the',
      licenseLabel: 'Creative Commons Attribution-ShareAlike 4.0 License',
      licenseAfter:
        '; additional terms may apply. Putrajaya.rblx Wiki is a community project and is not affiliated with Roblox Corporation.',
      footerNav: 'Wiki footer',
      privacy: 'Privacy policy',
      about: 'About the wiki',
      disclaimers: 'Disclaimers',
      contact: 'Contact',
      contributing: 'Contributing',
      developers: 'Developers',
      statistics: 'Statistics',
      cookies: 'Cookie statement',
      top: 'Back to top',
      scan: 'Scan for community links',
      qrAlt: 'QR code for Putrajaya.rblx community links',
    };

const issueTitle = `Issue on ${Astro.url.pathname}`;
const issueBody = `Page: ${Astro.url.href}\n\n${t.body}\n\n`;
const reportHref = `https://github.com/Putrajayarblx/Putrajayarblx-Wiki/issues/new?title=${encodeURIComponent(issueTitle)}&body=${encodeURIComponent(issueBody)}`;
---

<Default />

<div
  class="pw-helpful"
  data-pw-helpful
  data-min-label={t.minute}
  data-thanks-yes={t.thanksYes}
  data-thanks-no={t.thanksNo}
  hidden
>
  <p>{t.helpful}</p>
  <button class="pw-helpful__btn" type="button" data-pw-vote="yes" aria-pressed="false">
    <PwIcon name="bi-hand-thumbs-up" />
    {t.yes}
  </button>
  <button class="pw-helpful__btn" type="button" data-pw-vote="no" aria-pressed="false">
    <PwIcon name="bi-hand-thumbs-down" />
    {t.no}
  </button>
  <span class="pw-helpful__thanks" data-pw-thanks aria-live="polite" hidden></span>
</div>

{
  hasSidebar && (
    <a class="pw-report" href={reportHref} target="_blank" rel="noopener noreferrer">
      <PwIcon name="bi-exclamation-triangle" />
      {t.report}
    </a>
  )
}

<footer class="pw-footer">
  <div class="pw-footer__inner">
    <div class="pw-footer__copy">
      <p class="pw-footer__render">
        {t.rendered}{' '}
        <a href="https://astro.build/" target="_blank" rel="noopener noreferrer">
          Astro {astroVersion}
        </a>
        {' · '}
        <a href="https://starlight.astro.build/" target="_blank" rel="noopener noreferrer">
          Starlight {starlightVersion}
        </a>
        {' · '}
        <a href="https://pagefind.app/" target="_blank" rel="noopener noreferrer">Pagefind</a>
        {' · '}
        <a href="https://vercel.com/" target="_blank" rel="noopener noreferrer">Vercel</a>
        {
          commit && commitUrl && (
            <>
              {' · '}
              <a href={commitUrl} target="_blank" rel="noopener noreferrer">
                {t.commit} {commit}
              </a>
            </>
          )
        }
      </p>

      <p class="pw-footer__license">
        {t.licenseBefore}{' '}
        <a
          href="https://creativecommons.org/licenses/by-sa/4.0/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.licenseLabel}
        </a>
        {t.licenseAfter}
      </p>

      <nav class="pw-footer__links" aria-label={t.footerNav}>
        <a href={`${base}/privacy/`}>{t.privacy}</a>
        <a href={`${base}/`}>{t.about}</a>
        <a href={`${base}/privacy/#${disclaimerHash}`}>{t.disclaimers}</a>
        <a href="https://discord.gg/Ng8rVaE7bX" target="_blank" rel="noopener noreferrer">
          {t.contact}
        </a>
        <a
          href="https://github.com/Putrajayarblx/Putrajayarblx-Wiki/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.contributing}
        </a>
        <a
          href="https://github.com/Putrajayarblx/Putrajayarblx-Wiki"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t.developers}
        </a>
        <a href={`${base}/#stats`}>{t.statistics}</a>
        <a href={`${base}/privacy/#${cookiesHash}`}>{t.cookies}</a>
        <a href="#_top">{t.top}</a>
      </nav>
    </div>

    <div class="pw-footer__aside">
      <a
        class="pw-footer__qr"
        href={linksHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={t.scan}
      >
        <img src={qrSrc} alt={t.qrAlt} width="112" height="112" />
        <span>{t.scan}</span>
      </a>
      <div class="pw-footer__mark">
        <img src="/logo.svg" alt="" width="28" height="28" />
        <span>
          <strong>Putrajaya.rblx</strong>
          <small>Wiki</small>
        </span>
      </div>
    </div>
  </div>
</footer>

<script>
  const content = document.querySelector('.sl-markdown-content');
  const widget = document.querySelector<HTMLElement>('[data-pw-helpful]');
  const isDocPage = Boolean(document.getElementById('starlight__sidebar'));

  if (content && widget && isDocPage) {
    const minLabel = widget.dataset.minLabel ?? 'min read';
    const thanksYes = widget.dataset.thanksYes ?? 'Thanks!';
    const thanksNo = widget.dataset.thanksNo ?? 'Noted.';

    const words = (content.textContent ?? '').trim().split(/\s+/).filter(Boolean).length;
    const minutes = Math.max(1, Math.round(words / 220));
    const title = document.querySelector('h1[data-page-title], #_top');
    if (title) {
      const line = document.createElement('p');
      line.className = 'pw-readtime';
      line.textContent = `${minutes} ${minLabel}`;
      title.insertAdjacentElement('afterend', line);
    }

    const key = `pw-helpful:${location.pathname}`;
    const thanks = widget.querySelector<HTMLElement>('[data-pw-thanks]');
    const buttons = [...widget.querySelectorAll<HTMLButtonElement>('[data-pw-vote]')];

    const show = (vote: string) => {
      if (!thanks) return;
      thanks.hidden = false;
      thanks.textContent = vote === 'yes' ? thanksYes : thanksNo;
    };

    const mark = (vote: string) => {
      for (const button of buttons) {
        const selected = button.dataset.pwVote === vote;
        button.setAttribute('aria-pressed', String(selected));
      }
      show(vote);
    };

    // Storage can be unavailable (private mode, blocked cookies). The
    // widget should still work without it.
    const read = () => {
      try {
        return localStorage.getItem(key);
      } catch {
        return null;
      }
    };
    const save = (vote: string) => {
      try {
        localStorage.setItem(key, vote);
      } catch {
        /* ignore */
      }
    };

    let saved = read();
    widget.hidden = false;
    if (saved) mark(saved);

    for (const button of buttons) {
      button.addEventListener('click', () => {
        const vote = button.dataset.pwVote ?? '';
        const previous = saved;
        if (vote === previous) {
          mark(vote);
          return;
        }
        save(vote);
        saved = vote;
        mark(vote);

        // Record the vote as a Vercel Web Analytics custom event.
        const analytics = (
          window as unknown as {
            va?: (type: string, payload?: unknown) => void;
          }
        ).va;
        analytics?.('event', {
          name: 'helpful',
          data: { vote, path: location.pathname, changed: previous !== null },
        });
      });
    }
  }
</script>
